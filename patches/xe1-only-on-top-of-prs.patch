+            const size_t off = i * chunk, len = std::min(chunk, size - off);
+            if (i >= 2) {
+                ev[i % 2].wait();
+            }
+            memcpy(pin[i % 2], (const char *) src + off, len);
+            ev[i % 2] = q.memcpy((char *) dst + off, pin[i % 2], len);
+        }
+        ev[0].wait();
+        ev[1].wait();
+    }
