+// ---------------------------------------------------------------------------------------------
+// Q3_K (reordered) x f32 GEMM on the XMX engines with the dequantization fused in: the weights are
+// read as Q3_K (0.43 byte per weight instead of 2 for an fp16 copy) and expanded to u8 per chunk of
+// 32: w = (q - 4) * (code - 32) + 124 in [0, 252] (exact, the sub-scale folded in), the activations
+// are quantized once to int8 per 32 in the VNNI layout of the DPAS B operand. One u8 x s8 DPAS per
+// chunk and 8-column tile; the +124 offset is removed with the column sums of the quantized
+// activations: sum (w + 124) y = sum w y + 124 sum y. A thread owns 8 weight rows and NT column
+// tiles (the weight expansion is shared by NT * 8 columns); KS threads of a work-group split K.
+// ---------------------------------------------------------------------------------------------
+// activations -> int8 with one scale per 256 (a Q3_K super-block), in the VNNI layout of the DPAS B
+// operand: yv[tile][chunk of 32][kq 8][col 8][4 bytes]; yd / ys [tile][block][col]: scale and 124 * sum
+static void q3k_gemm_quant_y(const float * y, const int ldy, const int ncols, const int k, const int ntiles,
+                             int8_t * yv, float * yd, int * ys, dpct::queue_ptr stream) {
+    const int nchunks = k / 32;
+    const int nblocks = k / QK_K;
+    stream->parallel_for(sycl::range<1>((size_t) ntiles * nblocks * 8), [=](sycl::item<1> it) {
+        const size_t id   = it.get_id(0);
+        const int    n    = id % 8;
+        const size_t tb   = id / 8;  // tile * nblocks + block
+        const int    b    = tb % nblocks;
+        const int    tile = tb / nblocks;
+        const int    col  = tile * 8 + n;
+        int *        yw   = (int *) yv + ((size_t) tile * nchunks + (size_t) b * 8) * 64 + n;
+        if (col >= ncols) {
+            for (int c = 0; c < 8; ++c) {
+#pragma unroll
+                for (int kq = 0; kq < 8; ++kq) {
+                    yw[c * 64 + kq * 8] = 0;
+                }
+            }
+            yd[tb * 8 + n] = 0.0f;
+            ys[tb * 8 + n] = 0;
+            return;
+        }
+        const float * yy   = y + (size_t) col * ldy + (size_t) b * QK_K;
+        float         amax = 0.0f;
+        for (int i = 0; i < QK_K; ++i) {
+            amax = sycl::fmax(amax, sycl::fabs(yy[i]));
+        }
+        const float id_ = amax > 0.0f ? 127.0f / amax : 0.0f;
+        int         sum = 0;
+        for (int c = 0; c < 8; ++c) {
+#pragma unroll
+            for (int kq = 0; kq < 8; ++kq) {
+                uint32_t w = 0;
+#pragma unroll
+                for (int bb = 0; bb < 4; ++bb) {
+                    const int q = (int) sycl::rint(yy[c * 32 + 4 * kq + bb] * id_);
+                    sum += q;
+                    w |= ((uint32_t) (q & 0xFF)) << (8 * bb);
+                }
+                yw[c * 64 + kq * 8] = (int) w;
+            }
+        }
+        yd[tb * 8 + n] = amax / 127.0f;
+        ys[tb * 8 + n] = 124 * sum;
+    });
+}
+
+template <int NT, int TM>
+ESIMD_INLINE void q3k_gemm_xmx_thread(const void * vx, const int8_t * yv, const float * yd, const int * ys, float * out,
+                                      const int k, const int nrows, const int ncols, const int ldo, const int nchunks,
+                                      const int rg, const int tm, const int cg, const int b0, const int b1) {
+    using namespace sycl::ext::intel::esimd;
+    namespace xmx = sycl::ext::intel::esimd::xmx;
+    using traits  = ggml_sycl_esimd::esimd_reorder_q_traits<GGML_TYPE_Q3_K>;
+    const int    bpr = k / QK_K;
+    const size_t nb  = (size_t) nrows * bpr;
+    const auto   ps  = traits::make_ptrs(vx, nb);
+
+    int rr[8];
+#pragma unroll
+    for (int r = 0; r < 8; ++r) {
+        rr[r] = rg * 8 + r < nrows ? rg * 8 + r : nrows - 1;
+    }
+    const int t0 = cg * NT;
+
+    simd<float, 64> acc[NT];
+#pragma unroll
+    for (int t = 0; t < NT; ++t) {
+        acc[t] = 0.0f;
+    }
+    for (int ib = b0; ib < b1; ++ib) {
+        // weights of the 8 rows first (their latency overlaps the activation staging)
+        simd<uint8_t, 8 * 64> qs;
+        simd<uint8_t, 8 * 32> hm;
+        simd<uint32_t, 8 * 3> sc32;
+        simd<float, 8>        dr;
+#pragma unroll
+        for (int r = 0; r < 8; ++r) {
+            const size_t g = (size_t) rr[r] * bpr + ib;
+            qs.template select<64, 1>(64 * r) = block_load<uint8_t, 64>(ps.qs + g * (QK_K / 4));
+            hm.template select<32, 1>(32 * r) = block_load<uint8_t, 32>(ps.hmask + g * (QK_K / 8));
+            simd<uint8_t, 12> scr             = block_load<uint8_t, 12>(ps.scales + g * 12);
+            sc32.template select<3, 1>(3 * r) = scr.template bit_cast_view<uint32_t>();
+            dr[r]                             = (float) ps.d[g];
+        }
+        // the activation tiles of this block (NT tiles x 8 chunks x 256 bytes) staged once per
+        // work-group in SLM instead of every 8-row thread reading them through the caches
+        barrier();
+#pragma unroll
+        for (int q = tm; q < NT * 8; q += TM) {
+            const int    t = q / 8, c = q % 8;
+            simd<int, 64> v = block_load<int, 64>((const int *) (yv + ((size_t) (t0 + t) * nchunks + ib * 8 + c) * 256));
+            slm_block_store<int, 64>((uint32_t) (q * 256), v);
+        }
+        barrier();
+        simd<int16_t, 128> code;
+        {
+            simd<uint32_t, 8>  sa = sc32.template select<8, 3>(0);
+            simd<uint32_t, 8>  sb = sc32.template select<8, 3>(1);
+            simd<uint32_t, 8>  sc = sc32.template select<8, 3>(2);
+            const uint32_t     k1 = 0x03030303u, k2 = 0x0f0f0f0fu;
+            simd<uint32_t, 32> aux;
+            aux.template select<8, 4>(0) = (sa & k2) | ((sc & k1) << 4);
+            aux.template select<8, 4>(1) = (sb & k2) | (((sc >> 2) & k1) << 4);
+            aux.template select<8, 4>(2) = ((sa >> 4) & k2) | (((sc >> 4) & k1) << 4);
+            aux.template select<8, 4>(3) = ((sb >> 4) & k2) | (((sc >> 6) & k1) << 4);
+            code = convert<int16_t>(simd<uint8_t, 128>(aux.template bit_cast_view<uint8_t>())) - (int16_t) 32;
+        }
+        simd<int, 64> ci[NT];
+#pragma unroll
+        for (int t = 0; t < NT; ++t) {
+            ci[t] = 0;
+        }
+        // the 3-bit values with dword (4 bytes at a time) masks and shifts instead of byte ops
+        simd<uint32_t, 8 * 16> qs32 = qs.template bit_cast_view<uint32_t>();
+        simd<uint32_t, 8 * 8>  hm32 = hm.template bit_cast_view<uint32_t>();
+        // w = (q - 4) * code + 124 = q * code + (124 - 4 * code)
+        simd<int16_t, 128>     cb   = (int16_t) 124 - (int16_t) 4 * code;
+#pragma unroll
+        for (int s = 0; s < 8; ++s) {
+            simd<uint8_t, 256> A;
+#pragma unroll
+            for (int r = 0; r < 8; ++r) {
+                simd<uint32_t, 8> v = (qs32.template select<8, 1>(16 * r + 8 * (s / 4)) >> (2 * (s % 4))) & 0x03030303u;
+                v |= ((hm32.template select<8, 1>(8 * r) >> s) & 0x01010101u) << 2;
+                simd<int16_t, 32> q16 = convert<int16_t>(simd<uint8_t, 32>(v.template bit_cast_view<uint8_t>()));
+                simd<int16_t, 32> cs  = code.template replicate_vs_w_hs<2, 1, 16, 0>(16 * r + 2 * s);
+                simd<int16_t, 32> cc  = cb.template replicate_vs_w_hs<2, 1, 16, 0>(16 * r + 2 * s);
+                A.template select<32, 1>(32 * r) = convert<uint8_t>(q16 * cs + cc);
+            }
+#pragma unroll
+            for (int t = 0; t < NT; ++t) {
+                simd<int, 64>     Bi = slm_block_load<int, 64>((uint32_t) ((t * 8 + s) * 256));
+                simd<int8_t, 256> B  = Bi.template bit_cast_view<int8_t>();
+                ci[t]                = xmx::dpas<8, 8, int>(ci[t], B, A);
+            }
+        }
+        simd<float, 64> DR = dr.template replicate_vs_w_hs<8, 1, 8, 0>(0);
+#pragma unroll
+        for (int t = 0; t < NT; ++t) {
+            const size_t   tb  = (size_t) (t0 + t) * bpr + ib;
+            simd<float, 8> dy8 = block_load<float, 8>(yd + tb * 8);
+            simd<int, 8>   ys8 = block_load<int, 8>(ys + tb * 8);
+            acc[t] += convert<float>(ci[t] - ys8.template replicate<8>()) * (dy8.template replicate<8>() * DR);
+        }
+    }
+    if (rg * 8 >= nrows) {
+        return;
+    }
+#pragma unroll
+    for (int t = 0; t < NT; ++t) {
+#pragma unroll
+        for (int n = 0; n < 8; ++n) {
+            const int col = (t0 + t) * 8 + n;
+            if (col < ncols) {
+                simd<float, 8> v   = acc[t].template select<8, 8>(n);
+                const int      row = rg * 8;
+                if (row + 8 <= nrows) {
+                    block_store<float, 8>(out + (size_t) col * ldo + row, v);
+                } else {
+#pragma unroll
+                    for (int m = 0; m < 8; ++m) {
+                        if (row + m < nrows) {
+                            out[(size_t) col * ldo + row + m] = v[m];
+                        }
+                    }
+                }
+            }
+        }
+    }
+}
+
+// grid: (column groups, K splits, row groups / TM); work-group: TM threads of 8 rows each.
+// With KS > 1 every split writes its partial sums to out + ks * ostride, summed afterwards.
+template <int NT, int TM>
+static void q3k_gemm_xmx_launch(const void * vx, const int8_t * yv, const float * yd, const int * ys, float * out,
+                                const size_t ostride, const int ks_n, const int k, const int nrows, const int ncols,
+                                const int ldo, const int ntiles, dpct::queue_ptr stream) {
+    const int    nchunks = k / 32;
+    const int    bpr     = k / QK_K;
+    const size_t rgs     = ((size_t) nrows + 7) / 8;
+    const size_t wgs     = (rgs + TM - 1) / TM;
+    const size_t cgs     = ((size_t) ntiles + NT - 1) / NT;
+    stream->submit([&](sycl::handler & h) {
+        h.parallel_for(sycl::nd_range<3>(sycl::range<3>(cgs, ks_n, wgs * TM), sycl::range<3>(1, 1, TM)),
+                       sycl::ext::oneapi::experimental::properties{ sycl::ext::intel::experimental::grf_size<256> },
+                       [=](sycl::nd_item<3> it) [[intel::sycl_explicit_simd]] {
+                           sycl::ext::intel::esimd::slm_init<NT * 8 * 256>();
+                           const int ks = it.get_group(1);
+                           const int b0 = bpr * ks / ks_n;
+                           const int b1 = bpr * (ks + 1) / ks_n;
+                           q3k_gemm_xmx_thread<NT, TM>(vx, yv, yd, ys, out + (size_t) ks * ostride, k, nrows, ncols,
+                                                       ldo, nchunks, (int) it.get_global_id(2), (int) it.get_local_id(2),
+                                                       (int) it.get_group(0), b0, b1);
+                       });
+    });
+}
+
+bool ggml_sycl_q3k_gemm_xmx(const void * vx, const float * y, float * dst, int k, int nrows, int ncols, int ldy, int ldd,
+                            ggml_sycl_pool & pool, dpct::queue_ptr stream) {
+    if (k % QK_K != 0) {
+        return false;
+    }
+    const int ntiles  = (ncols + 7) / 8;
+    // GGML_SYCL_Q3K_GEMM_NT: column tiles (8 columns) per thread, 1/2/4/8
+    static const int nt_env = ggml_sycl_get_env("GGML_SYCL_Q3K_GEMM_NT", 8);
+    int              nt     = nt_env >= 8 ? 8 : nt_env >= 4 ? 4 : nt_env >= 2 ? 2 : 1;
+    while (nt > 1 && nt / 2 >= ntiles) {
+        nt /= 2;
+    }
+    const int ntiles_p = (ntiles + nt - 1) / nt * nt;
+    const int nchunks  = k / 32;
+    const int bpr      = k / QK_K;
+    ggml_sycl_pool_alloc<int8_t> yv(pool, (size_t) ntiles_p * nchunks * 256);
+    ggml_sycl_pool_alloc<float>  yd(pool, (size_t) ntiles_p * bpr * 8);
+    ggml_sycl_pool_alloc<int>    ys(pool, (size_t) ntiles_p * bpr * 8);
+    q3k_gemm_quant_y(y, ldy, ncols, k, ntiles_p, yv.get(), yd.get(), ys.get(), stream);
+    // GGML_SYCL_Q3K_GEMM_TM: 8-row threads per work-group sharing the staged activations
+    static const int tm_env = ggml_sycl_get_env("GGML_SYCL_Q3K_GEMM_TM", 16);
+    const int        tm     = tm_env >= 16 ? 16 : tm_env >= 8 ? 8 : 4;
+    // K split so that there are enough threads for the GPU
+    static const int ks_env = ggml_sycl_get_env("GGML_SYCL_Q3K_GEMM_KS", 0);
+    const long       thr    = (long) ((nrows + 7) / 8) * (ntiles_p / nt);
+    int              ks     = ks_env > 0 ? ks_env : (thr >= 4096 ? 1 : thr >= 2048 ? 2 : thr >= 1024 ? 4 : 8);
+    while (ks > 1 && ks > bpr) {
+        ks /= 2;
+    }
+    float *                     out = dst;
+    int                         ldo = ldd;
+    ggml_sycl_pool_alloc<float> part(pool);
+    const size_t                ostride = (size_t) ncols * nrows;
+    if (ks > 1) {
+        out = part.alloc(ostride * ks);
+        ldo = nrows;
+    }
+#define Q3K_GEMM_TM(NTT)                                                                                                     \
+    if (tm >= 16) {                                                                                                          \
+        q3k_gemm_xmx_launch<NTT, 16>(vx, yv.get(), yd.get(), ys.get(), out, ostride, ks, k, nrows, ncols, ldo, ntiles_p, stream); \
+    } else if (tm >= 8) {                                                                                                    \
+        q3k_gemm_xmx_launch<NTT, 8>(vx, yv.get(), yd.get(), ys.get(), out, ostride, ks, k, nrows, ncols, ldo, ntiles_p, stream);  \
+    } else {                                                                                                                 \
+        q3k_gemm_xmx_launch<NTT, 4>(vx, yv.get(), yd.get(), ys.get(), out, ostride, ks, k, nrows, ncols, ldo, ntiles_p, stream);  \
+    }
+    switch (nt) {
+        case 1: Q3K_GEMM_TM(1) break;
+        case 2: Q3K_GEMM_TM(2) break;
+        case 4: Q3K_GEMM_TM(4) break;
+        default: Q3K_GEMM_TM(8) break;
+    }
+#undef Q3K_GEMM_TM
+    if (ks > 1) {
+        const float * p = out;
+        stream->parallel_for(sycl::range<2>(ncols, nrows), [=](sycl::item<2> it) {
+            const int c = it.get_id(0), r = it.get_id(1);
+            float     v = 0.0f;
+            for (int j = 0; j < ks; ++j) {
+                v += p[j * ostride + (size_t) c * nrows + r];
+            }
+            dst[(size_t) c * ldd + r] = v;
+        });
+    }
+    return true;
+}
+#endif
