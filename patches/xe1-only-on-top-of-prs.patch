+template <ggml_type T>
+static void dmmv_reorder_esimd_ncols_switch(const void * vx, const float * y, float * dst, const int ncols,
+                                            const int nrows, const int ncols_dst, const int ldy, const int ldd,
+                                            dpct::queue_ptr stream) {
+    switch (ncols_dst) {
+        case 1: dmmv_reorder_esimd_ncols_launch<T, 1>(vx, y, dst, ncols, nrows, ldy, ldd, stream); break;
+        case 2: dmmv_reorder_esimd_ncols_launch<T, 2>(vx, y, dst, ncols, nrows, ldy, ldd, stream); break;
+        case 3: dmmv_reorder_esimd_ncols_launch<T, 3>(vx, y, dst, ncols, nrows, ldy, ldd, stream); break;
+        case 4: dmmv_reorder_esimd_ncols_launch<T, 4>(vx, y, dst, ncols, nrows, ldy, ldd, stream); break;
+        case 5: dmmv_reorder_esimd_ncols_launch<T, 5>(vx, y, dst, ncols, nrows, ldy, ldd, stream); break;
+        case 6: dmmv_reorder_esimd_ncols_launch<T, 6>(vx, y, dst, ncols, nrows, ldy, ldd, stream); break;
+        case 7: dmmv_reorder_esimd_ncols_launch<T, 7>(vx, y, dst, ncols, nrows, ldy, ldd, stream); break;
+        case 8: dmmv_reorder_esimd_ncols_launch<T, 8>(vx, y, dst, ncols, nrows, ldy, ldd, stream); break;
+        default: GGML_ABORT("ESIMD DMMV ncols: unsupported ncols_dst=%d", ncols_dst);
+    }
