+// Prefill-oriented variant (scalar gate, S_v = 128): each sub-group owns COLS state columns, so
+// the 48 heads x 128 columns fit in one wave of resident sub-groups (one column per sub-group needs
+// 6144 of them, two waves on an A770), and the two columns' reductions overlap. The next token's
+// k/q/v/beta/g are loaded before the current token's dependent chain.
+template <int S_v, bool keep_rs_t, int COLS>
+void gated_delta_net_sycl2(const float * q, const float * k, const float * v, const float * g, const float * beta,
+                           const float * curr_state, float * dst, float * state, int64_t H, int64_t n_tokens,
+                           int64_t sq1, int64_t sq2, int64_t sq3, int64_t sv1, int64_t sv2, int64_t sv3, int64_t sb1,
+                           int64_t sb2, int64_t sb3, const sycl::uint3 neqk1_magic, const sycl::uint3 rq3_magic,
+                           float scale, int64_t state_slot_stride, int K) {
+    auto           item_ct1 = sycl::ext::oneapi::this_work_item::get_nd_item<3>();
+    const uint32_t h_idx    = item_ct1.get_group(2);
+    const uint32_t sequence = item_ct1.get_group(1);
+    const int      lane     = item_ct1.get_local_id(2);
+    const int      col0     = (item_ct1.get_group(0) * item_ct1.get_local_range(1) + item_ct1.get_local_id(1)) * COLS;
+
+    const uint32_t iq1 = fastmodulo(h_idx, neqk1_magic);
+    const uint32_t iq3 = fastdiv(sequence, rq3_magic);
+
+    float *       attn_data        = dst;
+    const int64_t state_in_offset  = sequence * H * S_v * S_v + h_idx * S_v * S_v;
+    const int64_t state_out_offset = (sequence * H + h_idx) * S_v * S_v;
+    state += state_out_offset;
+    const float * cs = curr_state + state_in_offset;
+    attn_data += (sequence * n_tokens * H + h_idx) * S_v;
+
+    constexpr int warp_size     = ggml_sycl_get_physical_warp_size() < S_v ? ggml_sycl_get_physical_warp_size() : S_v;
+    constexpr int rows_per_lane = S_v / warp_size;
+    float         s_shard[COLS][rows_per_lane];
+#pragma unroll
+    for (int c = 0; c < COLS; c++) {
+#pragma unroll
+        for (int r = 0; r < rows_per_lane; r++) {
+            s_shard[c][r] = cs[(col0 + c) * S_v + r * warp_size + lane];
+        }
+    }
+
+    auto load_tok = [&](int t, float * kk, float * qq, float * vv, float & bt, float & gt) {
+        const float * q_t = q + iq3 * sq3 + t * sq2 + iq1 * sq1;
+        const float * k_t = k + iq3 * sq3 + t * sq2 + iq1 * sq1;
+        const float * v_t = v + sequence * sv3 + t * sv2 + h_idx * sv1;
+        const int64_t gbo = sequence * sb3 + t * sb2 + h_idx * sb1;
+#pragma unroll
+        for (int r = 0; r < rows_per_lane; r++) {
+            kk[r] = k_t[r * warp_size + lane];
+            qq[r] = q_t[r * warp_size + lane];
+        }
+#pragma unroll
+        for (int c = 0; c < COLS; c++) {
+            vv[c] = v_t[col0 + c];
+        }
+        bt = beta[gbo];
+        gt = g[gbo];
+    };
+
+    float kn[rows_per_lane], qn[rows_per_lane], vn[COLS], bn = 0.0f, gn = 0.0f;
+    if (n_tokens > 0) {
+        load_tok(0, kn, qn, vn, bn, gn);
+    }
+
+    for (int t = 0; t < n_tokens; t++) {
+        float kk[rows_per_lane], qq[rows_per_lane], vv[COLS];
+#pragma unroll
+        for (int r = 0; r < rows_per_lane; r++) {
+            kk[r] = kn[r];
+            qq[r] = qn[r];
+        }
+#pragma unroll
+        for (int c = 0; c < COLS; c++) {
+            vv[c] = vn[c];
+        }
+        const float beta_val = bn;
+        const float g_val    = sycl::native::exp(gn);
+        if (t + 1 < n_tokens) {
+            load_tok(t + 1, kn, qn, vn, bn, gn);
+        }
+
+        float kv_shard[COLS];
+#pragma unroll
+        for (int c = 0; c < COLS; c++) {
+            kv_shard[c] = 0.0f;
+#pragma unroll
+            for (int r = 0; r < rows_per_lane; r++) {
+                kv_shard[c] += s_shard[c][r] * kk[r];
+            }
+        }
+        float attn_partial[COLS];
+#pragma unroll
+        for (int c = 0; c < COLS; c++) {
+            const float kv_col    = warp_reduce_sum<warp_size>(kv_shard[c]);
+            const float delta_col = (vv[c] - g_val * kv_col) * beta_val;
+            attn_partial[c]       = 0.0f;
+#pragma unroll
+            for (int r = 0; r < rows_per_lane; r++) {
+                s_shard[c][r] = g_val * s_shard[c][r] + kk[r] * delta_col;
+                attn_partial[c] += s_shard[c][r] * qq[r];
+            }
+        }
+#pragma unroll
+        for (int c = 0; c < COLS; c++) {
+            const float attn_col = warp_reduce_sum<warp_size>(attn_partial[c]);
+            if (lane == 0) {
+                attn_data[col0 + c] = attn_col * scale;
+            }
+        }
+        attn_data += S_v * H;
+
+        if constexpr (keep_rs_t) {
+            const int target_slot = (int) n_tokens - 1 - t;
+            if (target_slot >= 0 && target_slot < K) {
+                float * st = state + target_slot * state_slot_stride;
+#pragma unroll
+                for (int c = 0; c < COLS; c++) {
+#pragma unroll
+                    for (int r = 0; r < rows_per_lane; r++) {
+                        st[(col0 + c) * S_v + r * warp_size + lane] = s_shard[c][r];
+                    }
+                }
+            }
+        }
+    }
+
+    if constexpr (!keep_rs_t) {
+#pragma unroll
+        for (int c = 0; c < COLS; c++) {
+#pragma unroll
+            for (int r = 0; r < rows_per_lane; r++) {
+                state[(col0 + c) * S_v + r * warp_size + lane] = s_shard[c][r];
+            }
+        }
+    }
+}
