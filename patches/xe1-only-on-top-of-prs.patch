+#ifdef GGML_SYCL_DMMV_HAS_ESIMD
+// matvec on the first nrows rows of a reordered tensor holding nrows_layout rows (row view at offset 0)
+void ggml_sycl_dmmv_reorder_view(ggml_type type, const void * vx, const float * y, float * dst, int ncols, int nrows,
+                                 int nrows_layout, int ncols_dst, int ldy, int ldd, dpct::queue_ptr stream) {
+    g_dmmv_layout_rows = nrows_layout;
+    for (int c0 = 0; c0 < ncols_dst;) {
+        const int nc = ncols_dst - c0 <= 4 ? ncols_dst - c0 : (ncols_dst - c0 + 1) / 2;
+        const float * yc = y + (size_t) c0 * ldy;
+        float *       dc = dst + (size_t) c0 * ldd;
+        c0 += nc;
+        switch (type) {
+            case GGML_TYPE_Q4_K: dmmv_reorder_esimd_ncols_switch<GGML_TYPE_Q4_K>(vx, yc, dc, ncols, nrows, nc, ldy, ldd, stream); break;
+            case GGML_TYPE_Q5_K: dmmv_reorder_esimd_ncols_switch<GGML_TYPE_Q5_K>(vx, yc, dc, ncols, nrows, nc, ldy, ldd, stream); break;
+            case GGML_TYPE_Q6_K: dmmv_reorder_esimd_ncols_switch<GGML_TYPE_Q6_K>(vx, yc, dc, ncols, nrows, nc, ldy, ldd, stream); break;
+            default: GGML_ABORT("reorder view matvec: unsupported type");
+        }
+    }
+    g_dmmv_layout_rows = 0;
+}
