+to_fp16_sycl_t ggml_sycl_iq_to_f16(ggml_type type, const ggml_tensor * src0) {
+    static const int mask = ggml_sycl_get_env("GGML_SYCL_IQ_F16", 511);
+    if (!g_ggml_sycl_enable_esimd || !src0 || !(mask & iqmv_type_bit(type)) || src0->ne[0] % (4 * QK_K) != 0) {
+        return nullptr;
+    }
+    const auto * extra = static_cast<const ggml_tensor_extra_gpu *>(src0->extra);
+    if (extra && extra->optimized_feature.reorder) {
+        return nullptr;
