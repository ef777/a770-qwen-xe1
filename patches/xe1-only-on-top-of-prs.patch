+        cur = ggml_scale_bias(ctx0, cur, 1.0f, 1000.0f);
+        ggml_tensor * ct = n_out == 1 ? ggml_reshape_2d(ctx0, cur, 1, cur->ne[0]) : ggml_cont(ctx0, ggml_transpose(ctx0, cur));  // [n_out, K]
