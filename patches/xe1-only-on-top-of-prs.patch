+                             for (int c = 0; c < NC; ++c) {
+                                 acc[c] = 0.0f;
+                             }
+                             for (int i = tid * 4; i < k; i += WG * 4) {
+                                 sycl::float4 w;
+                                 if constexpr (WT == 0) {
+                                     w = *(const sycl::float4 *) (xr + i);
+                                 } else {
+                                     // 4 consecutive weights of one 32-weight block
+                                     const size_t e = (size_t) row * k + i;
+                                     float        d;
+                                     sycl::char4  q;
+                                     if constexpr (WT == 1) {
+                                         const block_q8_0 * b = (const block_q8_0 *) x0 + e / QK8_0;
+                                         d                    = (float) b->d;
+                                         const int8_t * qp    = b->qs + e % QK8_0;
+                                         q = sycl::char4(qp[0], qp[1], qp[2], qp[3]);
+                                     } else {
+                                         q = *(const sycl::char4 *) ((const int8_t *) x0 + e);
+                                         d = (float) ((const sycl::half *) ((const int8_t *) x0 + (size_t) nrows * k))[e / QK8_0];
+                                     }
+                                     w = sycl::float4(q.x(), q.y(), q.z(), q.w()) * d;
+                                 }
