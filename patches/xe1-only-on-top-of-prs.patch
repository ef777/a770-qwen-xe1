+    stream->parallel_for(sycl::nd_range<1>(sycl::range<1>(ng), sycl::range<1>(WG)),
+                         [=](sycl::nd_item<1> it) [[intel::sycl_explicit_simd]] {
+                             const int row = it.get_global_id(0);
+                             const int lid  = it.get_local_id(0);
