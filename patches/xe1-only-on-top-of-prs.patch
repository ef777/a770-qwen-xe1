index 97e0cee7..a92556dc 100644
--- a/src/llama-model.cpp
+++ b/src/llama-model.cpp
@@ -1959,6 +1959,51 @@ bool llama_model_base::load_tensors(llama_model_loader & ml) {
         }
     }
 
+    // LLAMA_MTP_HEAD_ORDER=<file of int32 token ids, most frequent first>, LLAMA_MTP_HEAD_K=<rows>:
+    // copy the K listed rows of the output matrix into a compact matrix for the MTP draft head.
+    // The full head reads all ~250k rows (~1 GB) per drafted token; drafts almost always pick one of
+    // the few tens of thousands of tokens that actually occur, and the target verifies every token.
+    if (const char * order_path = getenv("LLAMA_MTP_HEAD_ORDER"); order_path && output && hparams.n_layer_nextn > 0 &&
+        output_s == nullptr && output->buffer) {
+        std::vector<int32_t> ids;
+        if (FILE * f = fopen(order_path, "rb")) {
+            int32_t v;
+            while (fread(&v, sizeof(v), 1, f) == 1) {
+                if (v >= 0 && v < output->ne[1]) {
+                    ids.push_back(v);
+                }
+            }
+            fclose(f);
+        }
+        const int64_t k = std::min<int64_t>(ids.size(), getenv("LLAMA_MTP_HEAD_K") ? atoll(getenv("LLAMA_MTP_HEAD_K")) : 32768);
+        if (k > 0 && k < output->ne[1]) {
+            ids.resize(k);
+            ggml_init_params ip = { 2 * ggml_tensor_overhead(), nullptr, true };
+            ggml_context *   cc = ggml_init(ip);
+            mtp_head_c          = ggml_new_tensor_2d(cc, output->type, output->ne[0], k);
+            mtp_head_ids        = ggml_new_tensor_1d(cc, GGML_TYPE_I32, k);
+            ggml_set_name(mtp_head_c, "mtp_head_c");
+            ggml_set_name(mtp_head_ids, "mtp_head_ids");
+            ggml_backend_buffer_t cb = ggml_backend_alloc_ctx_tensors_from_buft(cc, ggml_backend_buffer_get_type(output->buffer));
+            GGML_ASSERT(cb);
+            ggml_backend_buffer_set_usage(cb, GGML_BACKEND_BUFFER_USAGE_WEIGHTS);
+            const size_t         rb = output->nb[1];
+            std::vector<uint8_t> all(ggml_nbytes(output));
+            ggml_backend_tensor_get(output, all.data(), 0, all.size());
+            std::vector<uint8_t> rows((size_t) k * rb);
+            for (int64_t i = 0; i < k; ++i) {
+                memcpy(rows.data() + i * rb, all.data() + (size_t) ids[i] * rb, rb);
+            }
+            ggml_backend_tensor_set(mtp_head_c, rows.data(), 0, rows.size());
+            ggml_backend_tensor_set(mtp_head_ids, ids.data(), 0, k * sizeof(int32_t));
+            std::vector<ggml_backend_buffer_ptr> bufs;
+            bufs.emplace_back(cb);
+            pimpl->ctxs_bufs.emplace_back(ggml_context_ptr(cc), std::move(bufs));
+            LLAMA_LOG_INFO("%s: MTP draft head: %lld of %lld rows (%.1f MB) from %s\n", __func__, (long long) k,
+                           (long long) output->ne[1], rows.size() / 1048576.0, order_path);
+        }
+    }
+
     return true;
 }
 
