+
+// Decode/verify variant (scalar gate, S_v = 128, few tokens): one ESIMD thread owns GDN_EC state
+// columns of one head and keeps them in registers. The columns are read and written with block
+// loads/stores (512 B per column), the dot products are vector multiplies plus a reduction, and all
+// the threads fit in one wave, so the kernel is bound by the state traffic (read once, written once
+// per kept snapshot).
+constexpr int GDN_EC = 4;
+struct gdn_gather {
+    const float *   base = nullptr;
+    int64_t         row  = 0;
+    const int32_t * ids  = nullptr;
+};
+static gdn_gather g_gdn_gather;
+
+static int gdn_esimd_max_tokens() {
+    // GGML_SYCL_GDN_ESIMD=N: ESIMD register-resident kernel for up to N tokens (0 = off)
+    static const int n = ggml_sycl_get_env("GGML_SYCL_GDN_ESIMD", 1 << 30);
+    return n;
+}
+
+bool ggml_sycl_gdn_esimd_ok(const ggml_tensor * gdn) {
+    const ggml_tensor * v = gdn->src[2];
+    return gdn->src[3]->ne[0] == 1 && v->ne[0] == 128 && v->ne[2] <= gdn_esimd_max_tokens();
+}
+
+void ggml_sycl_gdn_set_gather(const ggml_tensor * gr) {
+    if (gr == nullptr) {
+        g_gdn_gather = {};
+        return;
+    }
+    g_gdn_gather.base = (const float *) gr->src[0]->data;
+    g_gdn_gather.row  = gr->src[0]->nb[1] / sizeof(float);
+    g_gdn_gather.ids  = (const int32_t *) gr->src[1]->data;
+}
+template <bool keep_rs_t, int EC>
+static void launch_gated_delta_net_esimd_ec(const float * q, const float * k, const float * v, const float * g,
+                                            const float * beta, const float * curr_state, float * dst, float * state,
+                                            int64_t H, int64_t n_tokens, int64_t n_seqs, int64_t sq1, int64_t sq2,
+                                            int64_t sq3, int64_t sv1, int64_t sv2, int64_t sv3, int64_t sb1,
+                                            int64_t sb2, int64_t sb3, int64_t neqk1, int64_t rq3, float scale,
+                                            int64_t state_slot_stride, int K, const float * g_base, int64_t g_row,
+                                            const int32_t * g_ids, dpct::queue_ptr stream) {
+    constexpr int S    = 128;
+    const int     n_cg = S / EC;
+    stream->parallel_for(
+        sycl::nd_range<1>(sycl::range<1>((size_t) n_seqs * H * n_cg), sycl::range<1>(n_cg)),
+        sycl::ext::oneapi::experimental::properties{ sycl::ext::intel::experimental::grf_size<256> },
+        [=](sycl::nd_item<1> it) SYCL_ESIMD_KERNEL {
+            using namespace sycl::ext::intel::esimd;
+            const int     cg   = it.get_local_id(0);
+            const int64_t grp  = it.get_group(0);
+            const int64_t h    = grp % H;
+            const int64_t seq  = grp / H;
+            const int64_t iq1  = h % neqk1;
+            const int64_t iq3  = seq / rq3;
+            const int     col0 = cg * EC;
+
+            const int64_t so = (seq * H + h) * S * S;
+            // input state: the gathered copy, or (skipped GET_ROWS) cache row g_ids[seq] directly
+            const float * si = g_ids ? g_base + (int64_t) g_ids[seq] * g_row + h * S * S : curr_state + so;
+            simd<float, S> st[EC];
+#pragma unroll
+            for (int c = 0; c < EC; ++c) {
+                st[c] = block_load<float, S>(si + (int64_t) (col0 + c) * S);
+            }
+            const float * kq0 = k + iq3 * sq3 + iq1 * sq1;
+            const float * qq0 = q + iq3 * sq3 + iq1 * sq1;
+            const float * vv0 = v + seq * sv3 + h * sv1 + col0;
+            const int64_t gb0 = seq * sb3 + h * sb1;
+            // the inputs of token t + 1 are loaded before token t is computed (the per-token chain is
+            // latency bound: the loads would otherwise stall every step)
+            simd<float, S>  kn = block_load<float, S>(kq0);
+            simd<float, S>  qn = block_load<float, S>(qq0);
+            simd<float, EC> vn = block_load<float, EC>(vv0);
+            float           bn = beta[gb0];
+            float           gn = g[gb0];
+            float * attn = dst + (seq * n_tokens * H + h) * S + col0;
+            for (int t = 0; t < n_tokens; ++t) {
+                const simd<float, S>  kk   = kn;
+                const simd<float, S>  qq   = qn;
+                const simd<float, EC> vt   = vn;
+                const float           bval = bn;
+                const float           gval = sycl::ext::intel::esimd::exp(gn);
+                if (t + 1 < n_tokens) {
+                    kn = block_load<float, S>(kq0 + (int64_t) (t + 1) * sq2);
+                    qn = block_load<float, S>(qq0 + (int64_t) (t + 1) * sq2);
+                    vn = block_load<float, EC>(vv0 + (int64_t) (t + 1) * sv2);
+                    bn = beta[gb0 + (int64_t) (t + 1) * sb2];
+                    gn = g[gb0 + (int64_t) (t + 1) * sb2];
+                }
+                simd<float, EC> o;
+#pragma unroll
+                for (int c = 0; c < EC; ++c) {
+                    const float kv    = reduce<float>(st[c] * kk, std::plus<>());
+                    const float delta = (vt[c] - gval * kv) * bval;
+                    st[c]             = st[c] * gval + kk * delta;
+                    o[c]              = reduce<float>(st[c] * qq, std::plus<>()) * scale;
+                }
+                block_store<float, EC>(attn + (int64_t) t * S * H, o);
+                if constexpr (keep_rs_t) {
+                    const int slot = (int) n_tokens - 1 - t;
+                    if (slot < K) {
+                        float * so_t = state + so + (int64_t) slot * state_slot_stride;
+#pragma unroll
+                        for (int c = 0; c < EC; ++c) {
+                            block_store<float, S>(so_t + (int64_t) (col0 + c) * S, st[c]);
+                        }
+                    }
+                }
+            }
+            if constexpr (!keep_rs_t) {
+#pragma unroll
+                for (int c = 0; c < EC; ++c) {
+                    block_store<float, S>(state + so + (int64_t) (col0 + c) * S, st[c]);
+                }
+            }
+        });
+}
+
+template <bool keep_rs_t>
+static void launch_gated_delta_net_esimd(const float * q, const float * k, const float * v, const float * g,
+                                         const float * beta, const float * curr_state, float * dst, float * state,
+                                         int64_t H, int64_t n_tokens, int64_t n_seqs, int64_t sq1, int64_t sq2,
+                                         int64_t sq3, int64_t sv1, int64_t sv2, int64_t sv3, int64_t sb1, int64_t sb2,
+                                         int64_t sb3, int64_t neqk1, int64_t rq3, float scale,
+                                         int64_t state_slot_stride, int K, const float * g_base, int64_t g_row,
+                                         const int32_t * g_ids, dpct::queue_ptr stream) {
+    // decode (few tokens): 4 columns per thread, the state traffic dominates; prefill: the per-token
+    // chain dominates, fewer columns per thread shorten it (GGML_SYCL_GDN_EC_PF: 1, 2 or 4)
+    static const int ec_pf = ggml_sycl_get_env("GGML_SYCL_GDN_EC_PF", 2);
+    const int        ec    = n_tokens <= 8 ? 4 : ec_pf;
+#define GDN_ESIMD_EC(E)                                                                                          \
+    launch_gated_delta_net_esimd_ec<keep_rs_t, E>(q, k, v, g, beta, curr_state, dst, state, H, n_tokens, n_seqs, \
+                                                  sq1, sq2, sq3, sv1, sv2, sv3, sb1, sb2, sb3, neqk1, rq3, scale,  \
+                                                  state_slot_stride, K, g_base, g_row, g_ids, stream)
+    if (ec == 1) {
+        GDN_ESIMD_EC(1);
+    } else if (ec == 2) {
+        GDN_ESIMD_EC(2);
+    } else {
+        GDN_ESIMD_EC(4);
+    }
+#undef GDN_ESIMD_EC
+}
