+            ev[i % 2].wait();
+            if (i + 1 < n) {
+                issue(i + 1);
+            }
+            const size_t off = i * chunk, len = std::min(chunk, size - off);
+            memcpy((char *) dst + off, pin[i % 2], len);
+        }
+    } else {
