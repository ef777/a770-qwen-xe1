+                                 for (int c = 0; c < NC; ++c) {
+                                     const sycl::float4 v = *(const sycl::float4 *) (y + (size_t) c * ldy + i);
+                                     acc[c] += w.x() * v.x() + w.y() * v.y() + w.z() * v.z() + w.w() * v.w();
