+                             } else if (row < nrows) {
+                                 if (bs4) {
+                                     q3k_fast_mv_row<NC, 4, false>(vx, y, dst, ncols, nrows, ldy, ldd, row, lid);
+                                 } else {
+                                     q3k_fast_mv_row<NC, 2, false>(vx, y, dst, ncols, nrows, ldy, ldd, row, lid);
