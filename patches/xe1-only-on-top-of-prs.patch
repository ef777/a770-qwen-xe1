+// Work-group variant of the ESIMD q8_0 D=256 decode kernel: the threads of a work-group share one
+// (KV head, chunk) and own GQA_ESIMD_RT query rows each. Every tile of TP positions is dequantized
+// once, cooperatively, into SLM (f32 K and V rows); the threads read it from there. The per-thread
+// variant above loads and dequantizes every K/V row in every thread (gqa * n_tok / RT times).
+template <int RT, int SLM_ES = 4>
+static void gqa_dec_partial_esimd_slm_q8_256(const char * Q, const char * K, const char * V, const char * mask,
+                                             float * part, float * meta, float scale, int n_tok, int n_head, int gqa,
+                                             int n_kv, int n_chunks, size_t nbq1, size_t nbq2, size_t nbk1,
+                                             size_t nbk2, size_t nbv1, size_t nbv2, size_t nbm1, int chunk_sz,
+                                             dpct::queue_ptr stream) {
+    constexpr int D    = 256;
+    constexpr int TP   = 8;
+    const int     rows = gqa * n_tok;
+    const int     n_rg = rows / RT;  // threads per work-group
+    const int     n_kvh = n_head / gqa;
+    const int     tpf   = gqa_esimd_tile_pf();
+
+    stream->submit([&](sycl::handler & cgh) {
+        cgh.parallel_for(
+            sycl::nd_range<1>(sycl::range<1>((size_t) n_kvh * n_chunks * n_rg), sycl::range<1>(n_rg)),
+            sycl::ext::oneapi::experimental::properties{ sycl::ext::intel::experimental::grf_size<256> },
+            [=](sycl::nd_item<1> it) SYCL_ESIMD_KERNEL {
+                using namespace sycl::ext::intel::esimd;
+                slm_init<2 * TP * D * SLM_ES>();  // K tile then V tile (f32, or f16 with FA_SLM_F16)
+                const int rg    = it.get_local_id(0);
+                const int grp   = it.get_group(0);
+                const int chunk = grp % n_chunks;
+                const int kvh   = grp / n_chunks;
+                const int p0    = chunk * chunk_sz;
+                const int p1    = p0 + chunk_sz < n_kv ? p0 + chunk_sz : n_kv;
+
+                simd<float, D> q[RT];
+                simd<float, D> acc[RT];
+                int            tt[RT], hh[RT];
+                float          m[RT], ssum[RT];
+#pragma unroll
+                for (int j = 0; j < RT; ++j) {
+                    const int r = rg * RT + j;
+                    tt[j]       = r / gqa;
+                    hh[j]       = kvh * gqa + r % gqa;
+                    q[j]   = block_load<float, D>((const float *) (Q + (size_t) tt[j] * nbq1 + (size_t) hh[j] * nbq2)) * scale;
+                    acc[j] = 0.0f;
+                    m[j]    = -INFINITY;
+                    ssum[j] = 0.0f;
+                }
+                const char * Kh = K + (size_t) kvh * nbk2;
+                const char * Vh = V + (size_t) kvh * nbv2;
+
+                for (int p = p0; p < p1; p += TP) {
+                    const int np = p1 - p < TP ? p1 - p : TP;
+                    if (tpf > 0) {
+                        for (int i = rg; i < 2 * TP; i += n_rg) {
+                            const int pn = p + tpf * TP + i % TP;
+                            if (pn < p1) {
+                                gqa_esimd_prefetch_row_q8_256(i < TP ? Kh + (size_t) pn * nbk1 : Vh + (size_t) pn * nbv1);
+                            }
+                        }
+                    }
+                    // cooperative dequantization of the tile: rows 0..TP-1 = K, TP..2TP-1 = V
+                    barrier();
+                    for (int i = rg; i < 2 * TP; i += n_rg) {
+                        const int    pi  = p + (i % TP < np ? i % TP : np - 1);
+                        const char * row = i < TP ? Kh + (size_t) pi * nbk1 : Vh + (size_t) pi * nbv1;
+                        simd<uint32_t, 68> raw = gqa_esimd_load_row_q8_256(row);
+                        simd<float, D>     f;
+                        gqa_esimd_deq_raw_q8_256(raw, f);
+#pragma unroll
+                        for (int c = 0; c < D / 64; ++c) {
+                            if constexpr (SLM_ES == 2) {
+                                slm_block_store<sycl::half, 64>((uint32_t) ((i * D + 64 * c) * SLM_ES),
+                                                                simd<sycl::half, 64>(f.template select<64, 1>(64 * c)));
+                            } else {
+                                slm_block_store<float, 64>((uint32_t) ((i * D + 64 * c) * SLM_ES), f.template select<64, 1>(64 * c));
+                            }
+                        }
+                    }
+                    barrier();
+
+                    simd<float, TP> s_t[RT];
+#pragma unroll
+                    for (int j = 0; j < RT; ++j) {
+                        if (mask && np == TP) {
+                            simd<uint32_t, TP / 2> mr = block_load<uint32_t, TP / 2>(
+                                (const uint32_t *) (mask + (size_t) tt[j] * nbm1 + (size_t) p * sizeof(sycl::half)));
+                            s_t[j] = convert<float>(mr.template bit_cast_view<sycl::half>().read());
+                        } else {
+#pragma unroll
+                            for (int i = 0; i < TP; ++i) {
+                                s_t[j][i] = i >= np ? -INFINITY
+                                                    : (mask ? (float) ((const sycl::half *) (mask + (size_t) tt[j] * nbm1))[p + i] : 0.0f);
+                            }
+                        }
+                    }
+#pragma unroll
+                    for (int i = 0; i < TP; ++i) {
+                        simd<float, D> kf;
+#pragma unroll
+                        for (int c = 0; c < D / 64; ++c) {
+                            if constexpr (SLM_ES == 2) {
+                                kf.template select<64, 1>(64 * c) = convert<float>(slm_block_load<sycl::half, 64>((uint32_t) ((i * D + 64 * c) * SLM_ES)));
+                            } else {
+                                kf.template select<64, 1>(64 * c) = slm_block_load<float, 64>((uint32_t) ((i * D + 64 * c) * SLM_ES));
+                            }
+                        }
+#pragma unroll
+                        for (int j = 0; j < RT; ++j) {
+                            const float sv = s_t[j][i];
+                            s_t[j][i]      = sv == -INFINITY ? -INFINITY : sv + reduce<float>(q[j] * kf, std::plus<>());
+                        }
+                    }
+                    simd<float, TP> p_t[RT];
+#pragma unroll
+                    for (int j = 0; j < RT; ++j) {
+                        const float tmax  = hmax<float>(s_t[j]);
+                        const float m_new = tmax > m[j] ? tmax : m[j];
+                        if (m_new == -INFINITY) {
+                            p_t[j] = 0.0f;
+                            continue;
+                        }
+                        const float a_s = m[j] == -INFINITY ? 0.0f : sycl::exp(m[j] - m_new);
+                        p_t[j]          = exp(s_t[j] - m_new);
+                        ssum[j]         = ssum[j] * a_s + reduce<float>(p_t[j], std::plus<>());
+                        m[j]            = m_new;
+                        acc[j] *= a_s;
+                    }
+#pragma unroll
+                    for (int i = 0; i < TP; ++i) {
+                        simd<float, D> vf;
+#pragma unroll
+                        for (int c = 0; c < D / 64; ++c) {
+                            vf.template select<64, 1>(64 * c) =
+                                SLM_ES == 2 ? simd<float, 64>(convert<float>(slm_block_load<sycl::half, 64>((uint32_t) (((TP + i) * D + 64 * c) * SLM_ES))))
+                                            : slm_block_load<float, 64>((uint32_t) (((TP + i) * D + 64 * c) * SLM_ES));
+                        }
+#pragma unroll
+                        for (int j = 0; j < RT; ++j) {
+                            const float pw = p_t[j][i];
+                            acc[j] += vf * pw;
+                        }
+                    }
+                }
+#pragma unroll
+                for (int j = 0; j < RT; ++j) {
+                    const size_t row_id = ((size_t) chunk * n_tok + tt[j]) * n_head + hh[j];
+                    block_store<float, D>(part + row_id * D, acc[j]);
+                    simd<float, 2> mm;
+                    mm[0] = m[j];
+                    mm[1] = ssum[j];
+                    block_store<float, 2>(meta + row_id * 2, mm);
+                }
+            });
+    });
+}
