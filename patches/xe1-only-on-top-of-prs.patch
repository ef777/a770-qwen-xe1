+            simd<float, 2 * NG> dg2;
+#pragma unroll
+            for (int g = 0; g < NG; ++g) {
+                const float dgv = dg[g];
+                dg2[2 * g]      = dgv;
+                dg2[2 * g + 1]  = dgv;
+            }
+            // work-item lid covers groups [lid * 2 * NG, +2 * NG) of the step: block lid * 2 * NG / 16
+            {
+                constexpr int GPB = 16;                          // groups of 16 per block
+                const int     g0  = lid * 2 * NG;                // first group of this work-item
+                const int     blk = g0 / GPB, gi = g0 % GPB;
+                slm_block_store<float, 2 * NG>((uint32_t) (QBYTES + ((c * BS + blk) * 32 + gi) * sizeof(float)), dg2);
+            }
+            // 4 * sum of each group of 16 quantized activations: the weights enter dp4a as q (0..7),
+            // sum (q - 4) y = sum q y - 4 sum y
+            simd<float, 2 * NG> ys;
+#pragma unroll
+            for (int j = 0; j < 2 * NG; ++j) {
+                ys[j] = (float) (4 * reduce<int>(simd<int, 16>(qi.template select<16, 1>(16 * j)), std::plus<>()));
+            }
+            {
+                constexpr int GPB = 16;
+                const int     g0  = lid * 2 * NG;
+                const int     blk = g0 / GPB, gi = g0 % GPB;
+                slm_block_store<float, 2 * NG>((uint32_t) (QBYTES + ((c * BS + blk) * 32 + 16 + gi) * sizeof(float)), ys);
+            }
+        }
+        barrier();
+
+        // 6-bit scale codes of the BS blocks at once: 3 dwords per block -> 4 dwords of 4 codes
+        simd<float, 16 * BS> sfa[R];
+#pragma unroll
+        for (int r = 0; r < R; ++r) {
+            simd<uint32_t, 3 * BS> s32 = scb[r].template bit_cast_view<uint32_t>();
+            simd<uint32_t, BS>     sa  = s32.template select<BS, 3>(0);
+            simd<uint32_t, BS>     sb  = s32.template select<BS, 3>(1);
+            simd<uint32_t, BS>     sc  = s32.template select<BS, 3>(2);
+            const uint32_t         k1  = 0x03030303u, k2 = 0x0f0f0f0fu;
+            simd<uint32_t, 4 * BS> aux;
+            aux.template select<BS, 4>(0) = (sa & k2) | ((sc & k1) << 4);
+            aux.template select<BS, 4>(1) = (sb & k2) | (((sc >> 2) & k1) << 4);
+            aux.template select<BS, 4>(2) = ((sa >> 4) & k2) | (((sc >> 4) & k1) << 4);
+            aux.template select<BS, 4>(3) = ((sb >> 4) & k2) | (((sc >> 6) & k1) << 4);
+            simd<float, 16 * BS> codes = convert<float>(simd<uint8_t, 16 * BS>(aux.template bit_cast_view<uint8_t>()));
+            simd<float, BS>      dbf   = convert<float>(db[r]);
+#pragma unroll
+            for (int blk = 0; blk < BS; ++blk) {
+                const float dv = dbf[blk];
+                sfa[r].template select<16, 1>(16 * blk) = (codes.template select<16, 1>(16 * blk) - 32.0f) * dv;
+            }
+        }
+#pragma unroll
+        for (int blk = 0; blk < BS; ++blk) {
+            simd<int, 64>   wd[R];
+            simd<float, 16> sf[R];
+#pragma unroll
+            for (int r = 0; r < R; ++r) {
+                simd<uint32_t, 16 * BS> qs32 = qsb[r].template bit_cast_view<uint32_t>();
+                simd<uint32_t, 8 * BS>  hm32 = hmb[r].template bit_cast_view<uint32_t>();
+                sf[r] = sfa[r].template select<16, 1>(16 * blk);
+                // 3-bit values with dword masks (4 weights per lane op): q = low 2 bits | high bit << 2
+#pragma unroll
+                for (int s = 0; s < 8; ++s) {
+                    simd<uint32_t, 8> v = (qs32.template select<8, 1>(16 * blk + 8 * (s / 4)) >> (2 * (s % 4))) & 0x03030303u;
+                    v |= ((hm32.template select<8, 1>(8 * blk) >> s) & 0x01010101u) << 2;
+                    wd[r].template select<8, 1>(8 * s) = v.template bit_cast_view<int>();
+                }
+            }
+#pragma unroll
+            for (int c = 0; c < NC; ++c) {
+                simd<int, 64>   yd = slm_block_load<int, 64>((uint32_t) (c * BS * 256 + blk * 256));
+                simd<float, 32> yey = slm_block_load<float, 32>((uint32_t) (QBYTES + ((c * BS + blk) * 32) * sizeof(float)));
+                simd<float, 16> ye  = yey.template select<16, 1>(0);
+                simd<float, 16> y4  = yey.template select<16, 1>(16);
+#pragma unroll
+                for (int r = 0; r < R; ++r) {
+                    simd<int, 64> p  = dp4a<int, int, int, int, 64>(simd<int, 64>(0), wd[r], yd);
+                    simd<int, 16> gs = p.template select<16, 4>(0) + p.template select<16, 4>(1) +
+                                       p.template select<16, 4>(2) + p.template select<16, 4>(3);
+                    acc[r][c] += (convert<float>(gs) - y4) * sf[r] * ye;
+                }
+            }
+        }
+        if constexpr (PIPE) {
+#pragma unroll
+            for (int r = 0; r < R; ++r) {
+                qsb[r] = qsn[r];
+                hmb[r] = hmn[r];
+                scb[r] = scn[r];
+                db[r]  = dn[r];
+            }
+        } else if (ib + BS < bpr) {
+            load_w(ib + BS, qsb, hmb, scb, db);
+        }
+    }
+#pragma unroll
+    for (int r = 0; r < R; ++r) {
+        if (row0 + r < nrows) {
+#pragma unroll
+            for (int c = 0; c < NC; ++c) {
+                dst[(size_t) c * ldd + row0 + r] = reduce<float>(acc[r][c], std::plus<>());
+            }
+        }
+    }
+}
+
+template <int NC, int WG, int R, bool PIPE>
+static void q3k_dp4a_mv_launch_wg(const void * vx, const float * y, float * dst, const int ncols, const int nrows,
+                                  const int ldy, const int ldd, dpct::queue_ptr stream) {
+    const size_t nt  = ((size_t) nrows + R - 1) / R;
+    const size_t ng  = (nt + WG - 1) / WG * WG;
+    const bool   bs4 = (ncols / QK_K) % 4 == 0;
+#define Q3K_DP4A_BODY                                                                                      const int row0 = it.get_global_id(0) * R;                                                              const int lid  = it.get_local_id(0);                                                                   sycl::ext::intel::esimd::slm_init<NC * 4 * (256 + 32 * sizeof(float))>();                              if (bs4) {                                                                                                 q3k_dp4a_mv_row<NC, 4, WG, R, PIPE>(vx, y, dst, ncols, nrows, ldy, ldd, row0, lid);                } else if constexpr (WG == 16) {                                                                           q3k_dp4a_mv_row<NC, 2, WG, R, PIPE>(vx, y, dst, ncols, nrows, ldy, ldd, row0, lid);                }
+    // out-of-range threads still join the barriers; loads use clamped rows
+    if constexpr (R > 1) {
+        // several rows per thread: the activation chunk read from SLM is reused R times, needs 256 GRF
+        stream->submit([&](sycl::handler & h) {
+            h.parallel_for(sycl::nd_range<1>(sycl::range<1>(ng), sycl::range<1>(WG)),
+                           sycl::ext::oneapi::experimental::properties{ sycl::ext::intel::experimental::grf_size<256> },
+                           [=](sycl::nd_item<1> it) [[intel::sycl_explicit_simd]] { Q3K_DP4A_BODY });
+        });
+    } else {
+        stream->parallel_for(sycl::nd_range<1>(sycl::range<1>(ng), sycl::range<1>(WG)),
+                             [=](sycl::nd_item<1> it) [[intel::sycl_explicit_simd]] { Q3K_DP4A_BODY });
+    }
+#undef Q3K_DP4A_BODY
+}
+
+template <int NC>
+static void q3k_dp4a_mv_launch(const void * vx, const float * y, float * dst, const int ncols, const int nrows,
+                               const int ldy, const int ldd, dpct::queue_ptr stream) {
+    // GGML_SYCL_Q3K_DP4A_R: weight rows per thread (1, 2, 4) for 3+ columns
+    static const int rn = ggml_sycl_get_env("GGML_SYCL_Q3K_DP4A_R", 1);
+    if ((ncols / QK_K) % 4 == 0 && NC >= 3 && rn >= 4) {
+        q3k_dp4a_mv_launch_wg<NC, 32, 4, false>(vx, y, dst, ncols, nrows, ldy, ldd, stream);
+    } else if ((ncols / QK_K) % 4 == 0 && NC >= 3 && rn >= 2) {
+        q3k_dp4a_mv_launch_wg<NC, 32, 2, false>(vx, y, dst, ncols, nrows, ldy, ldd, stream);
+    } else if ((ncols / QK_K) % 4 == 0) {
+        q3k_dp4a_mv_launch_wg<NC, 32, 1, false>(vx, y, dst, ncols, nrows, ldy, ldd, stream);
+    } else {
+        q3k_dp4a_mv_launch_wg<NC, 16, 1, false>(vx, y, dst, ncols, nrows, ldy, ldd, stream);
+    }
+}
+
+bool ggml_sycl_q3k_fast_ok(const ggml_tensor * src0, int64_t ncols_dst) {
+    static const int on = ggml_sycl_get_env("GGML_SYCL_Q3K_FAST", 1);
+    // GGML_SYCL_Q3K_DP4A: 0 = fp32 kernel only (1..3 columns), 1 = dp4a kernel except for 2 columns
+    // (default, the fp32 kernel is marginally faster there), 2 = dp4a kernel for 1..8 columns
+    static const int dp4a_mode = ggml_sycl_get_env("GGML_SYCL_Q3K_DP4A", 1);
+    const int        maxc      = dp4a_mode > 0 ? 8 : 3;
+    return on && src0->type == GGML_TYPE_Q3_K && ncols_dst >= 1 && ncols_dst <= maxc && (src0->ne[0] / QK_K) % 2 == 0;
+}
+
+void ggml_sycl_q3k_fast_mv(const void * vx, const float * y, float * dst, int ncols, int nrows, int ncols_dst, int ldy,
+                           int ldd, dpct::queue_ptr stream) {
+    static const int dp4a_mode = ggml_sycl_get_env("GGML_SYCL_Q3K_DP4A", 1);
+    const bool       use_dp4a  = dp4a_mode > 0 && (dp4a_mode >= 2 || ncols_dst != 2 || ncols_dst > 3);
+    if (use_dp4a) {
+        switch (ncols_dst) {
+            case 1: q3k_dp4a_mv_launch<1>(vx, y, dst, ncols, nrows, ldy, ldd, stream); return;
+            case 2: q3k_dp4a_mv_launch<2>(vx, y, dst, ncols, nrows, ldy, ldd, stream); return;
+            case 3: q3k_dp4a_mv_launch<3>(vx, y, dst, ncols, nrows, ldy, ldd, stream); return;
+            case 4: q3k_dp4a_mv_launch<4>(vx, y, dst, ncols, nrows, ldy, ldd, stream); return;
+            case 5: q3k_dp4a_mv_launch<5>(vx, y, dst, ncols, nrows, ldy, ldd, stream); return;
+            case 6: q3k_dp4a_mv_launch<6>(vx, y, dst, ncols, nrows, ldy, ldd, stream); return;
+            case 7: q3k_dp4a_mv_launch<7>(vx, y, dst, ncols, nrows, ldy, ldd, stream); return;
+            case 8: q3k_dp4a_mv_launch<8>(vx, y, dst, ncols, nrows, ldy, ldd, stream); return;
+            default: break;
+        }
+    }
+    switch (ncols_dst) {
+        case 1: q3k_fast_mv_launch<1>(vx, y, dst, ncols, nrows, ldy, ldd, stream); break;
+        case 2: q3k_fast_mv_launch<2>(vx, y, dst, ncols, nrows, ldy, ldd, stream); break;
+        case 3: q3k_fast_mv_launch<3>(vx, y, dst, ncols, nrows, ldy, ldd, stream); break;
+        case 4: q3k_fast_mv_launch<4>(vx, y, dst, ncols, nrows, ldy, ldd, stream); break;
+        default: GGML_ABORT("q3k fast mv: ncols_dst=%d", ncols_dst);
+    }
+}
+
+// i-quant matvec for 1..8 columns, plain (AoS) block layout, integer dot products: IQ4_XS, IQ4_NL,
+// IQ3_S, IQ3_XXS, IQ2_S, IQ2_XS, IQ2_XXS. The weights expand to int8 through a lookup table in SLM
+// (IQ4: a qs byte -> both of its nibble values, the others: their grid), every 32 (IQ2_S/XS: 16)
+// weights share one scale; the 32 activations of a q8 group are quantized per step into SLM (as in the
+// Q3_K dp4a kernel). One thread per weight row, 32 rows per work-group, 4 super-blocks per step.
+// GGML_SYCL_IQ_MV: bit mask 1 IQ4_XS, 2 IQ3_S, 4 IQ3_XXS, 8 IQ2_XXS, 16 IQ2_XS, 32 IQ2_S, 64 IQ4_NL.
+template <ggml_type T> struct iqmv_traits;
+// BB: bytes per 256 weights, TBL: table dwords, NG: scale groups per 256 weights
+template <> struct iqmv_traits<GGML_TYPE_IQ4_XS>  { static constexpr int BB = 136, TBL = 128,  NG = 8;  };
+template <> struct iqmv_traits<GGML_TYPE_IQ4_NL>  { static constexpr int BB = 144, TBL = 128,  NG = 8;  };
+template <> struct iqmv_traits<GGML_TYPE_IQ3_S>   { static constexpr int BB = 110, TBL = 512,  NG = 8;  };
+template <> struct iqmv_traits<GGML_TYPE_IQ3_XXS> { static constexpr int BB = 98,  TBL = 256,  NG = 8;  };
+template <> struct iqmv_traits<GGML_TYPE_IQ2_XXS> { static constexpr int BB = 66,  TBL = 512,  NG = 8;  };
+template <> struct iqmv_traits<GGML_TYPE_IQ2_XS>  { static constexpr int BB = 74,  TBL = 1024, NG = 16; };
+template <> struct iqmv_traits<GGML_TYPE_IQ2_S>   { static constexpr int BB = 82,  TBL = 2048, NG = 16; };
+// Q4_K: no table, 4-bit values with a per-32 scale and min (w = d sc q - dmin m)
+template <> struct iqmv_traits<GGML_TYPE_Q4_K>    { static constexpr int BB = 144, TBL = 0,    NG = 8;  };
+template <> struct iqmv_traits<GGML_TYPE_Q5_K>    { static constexpr int BB = 176, TBL = 0,    NG = 8;  };
+// Q6_K: signed 6-bit values (q - 32), int8 scale per 16
+template <> struct iqmv_traits<GGML_TYPE_Q6_K>    { static constexpr int BB = 210, TBL = 0,    NG = 16; };
+
+// AL: byte alignment of p (the step size and the row stride are multiples of it)
+template <int N, int AL, int O = 0>
+ESIMD_INLINE void iqmv_load_dw(sycl::ext::intel::esimd::simd<uint32_t, N> & r, const uint32_t * p) {
+    using namespace sycl::ext::intel::esimd;
+    if constexpr (O < N) {
+        constexpr int R = N - O;
+        constexpr int C = R >= 64 ? 64 : R >= 32 ? 32 : R >= 16 ? 16 : R >= 8 ? 8 : R >= 4 ? 4 : R >= 2 ? 2 : 1;
+        constexpr int A = (O * 4) % AL == 0 ? AL : 4;
+        r.template select<C, 1>(O) = block_load<uint32_t, C>(p + O, properties{ alignment<A> });
+        iqmv_load_dw<N, AL, O + C>(r, p);
+    }
+}
+
+// sign bytes (bit j: negate weight j of 8) -> per-byte masks of the two dwords holding those 8 weights;
+// applied as (g ^ m) + (m & 0x01010101): grid bytes are non-zero and < 128, the negation never carries
+template <int N>
+ESIMD_INLINE sycl::ext::intel::esimd::simd<uint32_t, 2 * N>
+iqmv_sign_masks(const sycl::ext::intel::esimd::simd<uint32_t, N> & s8) {
+    using namespace sycl::ext::intel::esimd;
+    simd<uint32_t, 2 * N> sb;
+    sb.template select<N, 2>(0) = s8 & 0xfu;
+    sb.template select<N, 2>(1) = (s8 >> 4) & 0xfu;
+    return ((sb * 0x00204081u) & 0x01010101u) * 0xffu;
+}
+
+// 7 stored sign bits + the parity bit (ksigns_iq2xs)
+template <int N>
+ESIMD_INLINE sycl::ext::intel::esimd::simd<uint32_t, N>
+iqmv_ksigns(const sycl::ext::intel::esimd::simd<uint32_t, N> & s7) {
+    using namespace sycl::ext::intel::esimd;
+    return s7 | ((cbit(s7) & 1u) << 7);
+}
+
+ESIMD_INLINE float iqmv_half(sycl::ext::intel::esimd::simd<uint8_t, 2> b) {
+    using namespace sycl::ext::intel::esimd;
+    simd<sycl::half, 1> h = b.template bit_cast_view<sycl::half>();
+    simd<float, 1>      f = convert<float>(h);
+    return f[0];
+}
+
+// IQ4 nibble pairs of 16 qs bytes -> 32 int8 weights (low nibbles first) through the 16-bit SLM table
+ESIMD_INLINE void iqmv_iq4_16(sycl::ext::intel::esimd::simd<uint8_t, 16> q, sycl::ext::intel::esimd::simd<int, 64> & wd,
+                              const int sb) {
+    using namespace sycl::ext::intel::esimd;
+    simd<uint16_t, 16> t  = slm_gather<uint16_t, 16>(convert<uint32_t>(q) * 2u);
+    auto               tb = t.template bit_cast_view<uint8_t>();
+    auto               wb = wd.template bit_cast_view<uint8_t>();
+    wb.template select<16, 1>(32 * sb)      = tb.template select<16, 2>(0);
+    wb.template select<16, 1>(32 * sb + 16) = tb.template select<16, 2>(1);
+}
+
+// the 256 weights at byte offset o of rb -> 64 dwords of int8 weights (natural order) and NG scales
+template <ggml_type T, typename RB>
+ESIMD_INLINE void iqmv_decode(RB rb, const int o, sycl::ext::intel::esimd::simd<int, 64> & wd,
+                              sycl::ext::intel::esimd::simd<float, iqmv_traits<T>::NG> & sf,
+                              sycl::ext::intel::esimd::simd<float, 8> & mf) {
+    using namespace sycl::ext::intel::esimd;
+    const simd<uint32_t, 8>  i8(0, 1);
+    const simd<uint32_t, 32> i32(0, 1);
+    if constexpr (T == GGML_TYPE_Q6_K) {
+        // ql[128] | qh[64] | scales[16] | d; per half h (128 weights): ql 64h.., qh 32h..
+        simd<uint8_t, 128> ql8 = rb.template select<128, 1>(o);
+        simd<uint8_t, 64>  qh8 = rb.template select<64, 1>(o + 128);
+        simd<uint32_t, 32> ql  = ql8.template bit_cast_view<uint32_t>();
+        simd<uint32_t, 16> qh  = qh8.template bit_cast_view<uint32_t>();
+        simd<uint32_t, 64> w;
+#pragma unroll
+        for (int h = 0; h < 2; ++h) {
+            simd<uint32_t, 8> A = ql.template select<8, 1>(16 * h);
+            simd<uint32_t, 8> B = ql.template select<8, 1>(16 * h + 8);
+            simd<uint32_t, 8> H = qh.template select<8, 1>(8 * h);
+            w.template select<8, 1>(32 * h)      = (A & 0x0f0f0f0fu) | ((H & 0x03030303u) << 4);
+            w.template select<8, 1>(32 * h + 8)  = (B & 0x0f0f0f0fu) | (((H >> 2) & 0x03030303u) << 4);
+            w.template select<8, 1>(32 * h + 16) = ((A >> 4) & 0x0f0f0f0fu) | (((H >> 4) & 0x03030303u) << 4);
+            w.template select<8, 1>(32 * h + 24) = ((B >> 4) & 0x0f0f0f0fu) | (((H >> 6) & 0x03030303u) << 4);
+        }
+        // q - 32 per byte without borrows between bytes
+        w  = ((w | 0x80808080u) - 0x20202020u) ^ 0x80808080u;
+        wd = w.template bit_cast_view<int>();
+        simd<uint8_t, 16> scu = rb.template select<16, 1>(o + 192);
+        simd<int8_t, 16>  sc  = scu.template bit_cast_view<int8_t>();
+        sf = convert<float>(sc) * iqmv_half(rb.template select<2, 1>(o + 208));
+    } else if constexpr (T == GGML_TYPE_Q4_K || T == GGML_TYPE_Q5_K) {
+        // d | dmin | scales[12] (6-bit scale and min of the 8 sub-blocks) | (Q5_K: qh[32]) | qs[128]: bytes
+        // 32j..32j+31 hold sub-block 2j in the low nibbles and 2j+1 in the high nibbles (Q5_K: 5th bits
+        // in bits 2j and 2j+1 of qh)
+        const float       d    = iqmv_half(rb.template select<2, 1>(o));
+        const float       dmin = iqmv_half(rb.template select<2, 1>(o + 2));
+        simd<uint32_t, 12> q   = convert<uint32_t>(simd<uint8_t, 12>(rb.template select<12, 1>(o + 4)));
+        simd<uint32_t, 8>  sc, mn;
+        sc.template select<4, 1>(0) = q.template select<4, 1>(0) & 63u;
+        mn.template select<4, 1>(0) = q.template select<4, 1>(4) & 63u;
+        sc.template select<4, 1>(4) = (q.template select<4, 1>(8) & 0xfu) | ((q.template select<4, 1>(0) >> 6) << 4);
+        mn.template select<4, 1>(4) = (q.template select<4, 1>(8) >> 4) | ((q.template select<4, 1>(4) >> 6) << 4);
+        sf = convert<float>(sc) * d;
+        mf = convert<float>(mn) * dmin;
+        constexpr int       QO  = T == GGML_TYPE_Q5_K ? 48 : 16;
+        simd<uint8_t, 128>  qs  = rb.template select<128, 1>(o + QO);
+        simd<uint32_t, 32>  q32 = qs.template bit_cast_view<uint32_t>();
+        simd<uint32_t, 64>  w;
+#pragma unroll
+        for (int j = 0; j < 4; ++j) {
+            w.template select<8, 1>(16 * j)     = q32.template select<8, 1>(8 * j) & 0x0f0f0f0fu;
+            w.template select<8, 1>(16 * j + 8) = (q32.template select<8, 1>(8 * j) >> 4) & 0x0f0f0f0fu;
+        }
+        if constexpr (T == GGML_TYPE_Q5_K) {
+            simd<uint8_t, 32> qh8 = rb.template select<32, 1>(o + 16);
+            simd<uint32_t, 8> qh  = qh8.template bit_cast_view<uint32_t>();
+#pragma unroll
+            for (int j = 0; j < 4; ++j) {
+                w.template select<8, 1>(16 * j) |= ((qh >> (2 * j)) & 0x01010101u) << 4;
+                w.template select<8, 1>(16 * j + 8) |= ((qh >> (2 * j + 1)) & 0x01010101u) << 4;
+            }
+        }
+        wd = w.template bit_cast_view<int>();
+    } else if constexpr (T == GGML_TYPE_IQ4_XS) {
+        // d | scales_h | scales_l[4] | qs[128]
+        const float       d   = iqmv_half(rb.template select<2, 1>(o));
+        simd<uint8_t, 8>  h8  = rb.template select<8, 1>(o);
+        simd<uint16_t, 4> h16 = h8.template bit_cast_view<uint16_t>();
+        simd<uint32_t, 2> h32 = h8.template bit_cast_view<uint32_t>();
+        simd<uint32_t, 8> ls  = ((simd<uint32_t, 8>(h32[1]) >> (i8 * 4)) & 0xfu) |
+                               (((simd<uint32_t, 8>((uint32_t) h16[1]) >> (i8 * 2)) & 3u) << 4);
+        sf = (convert<float>(ls) - 32.0f) * d;
+#pragma unroll
+        for (int sb = 0; sb < 8; ++sb) {
+            iqmv_iq4_16(rb.template select<16, 1>(o + 8 + 16 * sb), wd, sb);
+        }
+    } else if constexpr (T == GGML_TYPE_IQ4_NL) {
+        // 8 blocks of 32: d | qs[16]
+#pragma unroll
+        for (int sb = 0; sb < 8; ++sb) {
+            sf[sb] = iqmv_half(rb.template select<2, 1>(o + 18 * sb));
+            iqmv_iq4_16(rb.template select<16, 1>(o + 18 * sb + 2), wd, sb);
+        }
+    } else if constexpr (T == GGML_TYPE_IQ3_S) {
+        // d | qs[64] | qh[8] | signs[32] | scales[4]
+        const float       d  = iqmv_half(rb.template select<2, 1>(o));
+        simd<uint8_t, 4>  sc = rb.template select<4, 1>(o + 106);
+        simd<uint32_t, 8> sv = (convert<uint32_t>(simd<uint8_t, 8>(sc.template replicate_vs_w_hs<4, 1, 2, 0>(0))) >>
+                                ((i8 & 1u) * 4)) & 0xfu;
+        sf = (convert<float>(sv) * 2.0f + 1.0f) * d;
+        const simd<uint32_t, 64> i64(0, 1);
+        simd<uint8_t, 64>        qs  = rb.template select<64, 1>(o + 2);
+        simd<uint8_t, 8>         qh  = rb.template select<8, 1>(o + 66);
+        simd<uint32_t, 64>       qhr = convert<uint32_t>(simd<uint8_t, 64>(qh.template replicate_vs_w_hs<8, 1, 8, 0>(0)));
+        simd<uint32_t, 64>       idx = convert<uint32_t>(qs) | (((qhr >> (i64 & 7u)) & 1u) << 8);
+        simd<uint32_t, 64>       g;
+#pragma unroll
+        for (int k = 0; k < 4; ++k) {
+            g.template select<16, 1>(16 * k) = slm_gather<uint32_t, 16>(simd<uint32_t, 16>(idx.template select<16, 1>(16 * k)) * 4u);
+        }
+        simd<uint32_t, 64> m = iqmv_sign_masks<32>(convert<uint32_t>(simd<uint8_t, 32>(rb.template select<32, 1>(o + 74))));
+        simd<uint32_t, 64> w = (g ^ m) + (m & 0x01010101u);
+        wd                   = w.template bit_cast_view<int>();
+    } else if constexpr (T == GGML_TYPE_IQ3_XXS) {
+        // d | qs[64] (grid indices) | 8 x (4 x 7 sign bits | 4-bit scale)
+        const float        d   = iqmv_half(rb.template select<2, 1>(o));
+        simd<uint8_t, 64>  qs  = rb.template select<64, 1>(o + 2);
+        simd<uint8_t, 32>  sa8 = rb.template select<32, 1>(o + 66);
+        simd<uint32_t, 8>  sas = sa8.template bit_cast_view<uint32_t>();
+        sf = (convert<float>(simd<uint32_t, 8>(sas >> 28)) * 2.0f + 1.0f) * (0.25f * d);
+        simd<uint32_t, 64> g;
+#pragma unroll
+        for (int k = 0; k < 4; ++k) {
+            g.template select<16, 1>(16 * k) =
+                slm_gather<uint32_t, 16>(convert<uint32_t>(simd<uint8_t, 16>(qs.template select<16, 1>(16 * k))) * 4u);
+        }
+        simd<uint32_t, 32> s7 = (simd<uint32_t, 32>(sas.template replicate_vs_w_hs<8, 1, 4, 0>(0)) >> ((i32 & 3u) * 7)) & 127u;
+        simd<uint32_t, 64> m  = iqmv_sign_masks<32>(iqmv_ksigns<32>(s7));
+        simd<uint32_t, 64> w  = (g ^ m) + (m & 0x01010101u);
+        wd                    = w.template bit_cast_view<int>();
+    } else {
+        // IQ2: 32 grid entries of 8 weights (uint64)
+        const float        d = iqmv_half(rb.template select<2, 1>(o));
+        simd<uint32_t, 32> gi, s8;
+        if constexpr (T == GGML_TYPE_IQ2_XXS) {
+            // d | 8 x (4 grid index bytes | 4 x 7 sign bits + 4-bit scale)
+            simd<uint8_t, 64> q8 = rb.template select<64, 1>(o + 2);
+            simd<uint32_t, 16> q32 = q8.template bit_cast_view<uint32_t>();
+            simd<uint32_t, 8>  a0  = q32.template select<8, 2>(0);
+            simd<uint32_t, 8>  a1  = q32.template select<8, 2>(1);
+            gi = convert<uint32_t>(simd<uint8_t, 32>(a0.template bit_cast_view<uint8_t>()));
+            sf = (convert<float>(simd<uint32_t, 8>(a1 >> 28)) * 2.0f + 1.0f) * (0.125f * d);
+            s8 = iqmv_ksigns<32>((simd<uint32_t, 32>(a1.template replicate_vs_w_hs<8, 1, 4, 0>(0)) >> ((i32 & 3u) * 7)) & 127u);
+        } else if constexpr (T == GGML_TYPE_IQ2_XS) {
+            // d | qs[32] (9-bit grid index | 7 sign bits) | scales[8] (4 bits per 16 weights)
+            simd<uint8_t, 64>  q8  = rb.template select<64, 1>(o + 2);
+            simd<uint16_t, 32> q16 = q8.template bit_cast_view<uint16_t>();
+            gi = convert<uint32_t>(q16) & 511u;
+            s8 = iqmv_ksigns<32>(convert<uint32_t>(simd<uint16_t, 32>(q16 >> 9)));
+        } else {
+            // IQ2_S: d | qs[32] (grid index low bits) | signs[32] | qh[8] | scales[8]
+            simd<uint8_t, 8>   qh  = rb.template select<8, 1>(o + 66);
+            simd<uint32_t, 32> qhr = convert<uint32_t>(simd<uint8_t, 32>(qh.template replicate_vs_w_hs<8, 1, 4, 0>(0)));
+            gi = convert<uint32_t>(simd<uint8_t, 32>(rb.template select<32, 1>(o + 2))) | (((qhr >> ((i32 & 3u) * 2)) & 3u) << 8);
+            s8 = convert<uint32_t>(simd<uint8_t, 32>(rb.template select<32, 1>(o + 34)));
+        }
+        if constexpr (T != GGML_TYPE_IQ2_XXS) {
+            const simd<uint32_t, 16> i16(0, 1);
+            simd<uint8_t, 8>   sc = rb.template select<8, 1>(o + (T == GGML_TYPE_IQ2_XS ? 66 : 74));
+            simd<uint32_t, 16> sv = (convert<uint32_t>(simd<uint8_t, 16>(sc.template replicate_vs_w_hs<8, 1, 2, 0>(0))) >>
+                                     ((i16 & 1u) * 4)) & 0xfu;
+            sf = (convert<float>(sv) * 2.0f + 1.0f) * (0.125f * d);
+        }
+        simd<uint64_t, 32> g;
+#pragma unroll
+        for (int k = 0; k < 2; ++k) {
+            g.template select<16, 1>(16 * k) = slm_gather<uint64_t, 16>(simd<uint32_t, 16>(gi.template select<16, 1>(16 * k)) * 8u);
+        }
+        simd<uint32_t, 64> g32 = g.template bit_cast_view<uint32_t>();
+        simd<uint32_t, 64> m   = iqmv_sign_masks<32>(s8);
+        simd<uint32_t, 64> w   = (g32 ^ m) + (m & 0x01010101u);
+        wd                     = w.template bit_cast_view<int>();
+    }
+}
+
+template <ggml_type T, int NC>
+ESIMD_INLINE void iqmv_row(const uint8_t * vx, const uint32_t * tbl, const float * y, float * dst, const int ncols,
+                           const int nrows, const int ldy, const int ldd, const int row, const int lid) {
+    using namespace sycl::ext::intel::esimd;
+    constexpr int      BS   = 4;
+    constexpr int      WG   = BS * 8;  // one q8 group of 32 activations per work-item and column
+    constexpr int      BB   = iqmv_traits<T>::BB;
+    constexpr int      TBL  = iqmv_traits<T>::TBL;
+    constexpr int      NG   = iqmv_traits<T>::NG;
+    constexpr int      NDW  = BS * BB / 4;
+    constexpr int      AL   = (BS * BB) % 16 == 0 ? 16 : (BS * BB) % 8 == 0 ? 8 : 4;
+    constexpr bool     MIN  = T == GGML_TYPE_Q4_K || T == GGML_TYPE_Q5_K;
+    constexpr uint32_t QOFF = TBL * 4;
+    constexpr uint32_t SOFF = QOFF + NC * BS * 256;
+    constexpr uint32_t YOFF = SOFF + NC * BS * 8 * 4;  // activation sum of each q8 group (MIN)
+    if constexpr (TBL > 0) {
+        constexpr int PER = TBL / WG;
+        simd<uint32_t, PER> t = block_load<uint32_t, PER>(tbl + lid * PER);
+        slm_block_store<uint32_t, PER>((uint32_t) (lid * PER * 4), t);
+    }
+    const int        bpr  = ncols / QK_K;
+    const int        rr   = row < nrows ? row : nrows - 1;
+    const uint32_t * wrow = (const uint32_t *) (vx + (size_t) rr * bpr * BB);
+    simd<float, NG>  acc[NC];
+#pragma unroll
+    for (int c = 0; c < NC; ++c) {
+        acc[c] = 0.0f;
+    }
+    for (int ib = 0; ib < bpr; ib += BS) {
+        simd<uint32_t, NDW> raw;
+        iqmv_load_dw<NDW, AL>(raw, wrow + ib * BB / 4);
+        barrier();
+#pragma unroll
+        for (int c = 0; c < NC; ++c) {
+            simd<float, 32>  v    = block_load<float, 32>(y + (size_t) c * ldy + (size_t) ib * QK_K + lid * 32);
+            const float      amax = hmax<float>(abs(v));
+            const float      id   = amax > 0.0f ? 127.0f / amax : 0.0f;
+            simd<int8_t, 32> q8   = convert<int8_t>(convert<int>(rnde<float, 32>(simd<float, 32>(v * id))));
+            slm_block_store<uint32_t, 8>((uint32_t) (QOFF + c * BS * 256 + lid * 32), q8.template bit_cast_view<uint32_t>());
+            slm_scalar_store<float>((uint32_t) (SOFF + (c * BS * 8 + lid) * 4), amax / 127.0f);
+            if constexpr (MIN) {
+                slm_scalar_store<float>((uint32_t) (YOFF + (c * BS * 8 + lid) * 4), reduce<float>(v, std::plus<>()));
+            }
+        }
+        barrier();
+        auto rb = raw.template bit_cast_view<uint8_t>();
+#pragma unroll
+        for (int blk = 0; blk < BS; ++blk) {
+            simd<int, 64>   wd;
+            simd<float, NG> sf;
+            simd<float, 8>  mf;
+            iqmv_decode<T>(rb, blk * BB, wd, sf, mf);
+#pragma unroll
+            for (int c = 0; c < NC; ++c) {
+                simd<int, 64>  yd = slm_block_load<int, 64>((uint32_t) (QOFF + c * BS * 256 + blk * 256));
+                simd<float, 8> ye = slm_block_load<float, 8>((uint32_t) (SOFF + (c * BS * 8 + blk * 8) * 4));
+                simd<int, 64>  p  = dp4a<int, int, int, int, 64>(simd<int, 64>(0), wd, yd);
+                simd<int, 32>  p2 = p.template select<32, 2>(0) + p.template select<32, 2>(1);
+                simd<int, 16>  p4 = p2.template select<16, 2>(0) + p2.template select<16, 2>(1);
+                if constexpr (NG == 16) {
+                    acc[c] += convert<float>(p4) * sf * simd<float, 16>(ye.template replicate_vs_w_hs<8, 1, 2, 0>(0));
+                } else {
+                    simd<int, 8> gs = p4.template select<8, 2>(0) + p4.template select<8, 2>(1);
+                    acc[c] += convert<float>(gs) * sf * ye;
+                    if constexpr (MIN) {
+                        simd<float, 8> ys = slm_block_load<float, 8>((uint32_t) (YOFF + (c * BS * 8 + blk * 8) * 4));
+                        acc[c] -= mf * ys;
+                    }
+                }
+            }
+        }
+    }
+    if (row < nrows) {
+#pragma unroll
+        for (int c = 0; c < NC; ++c) {
+            dst[(size_t) c * ldd + row] = reduce<float>(acc[c], std::plus<>());
+        }
+    }
+}
+
+template <ggml_type T, int NC>
+static void iqmv_launch(const void * vx, const uint32_t * tbl, const float * y, float * dst, const int ncols,
+                        const int nrows, const int ldy, const int ldd, dpct::queue_ptr stream) {
+    constexpr int WG = 32;
+    const size_t  ng = ((size_t) nrows + WG - 1) / WG * WG;
+    stream->parallel_for(sycl::nd_range<1>(sycl::range<1>(ng), sycl::range<1>(WG)),
+                         [=](sycl::nd_item<1> it) [[intel::sycl_explicit_simd]] {
+                             sycl::ext::intel::esimd::slm_init<iqmv_traits<T>::TBL * 4 + NC * 4 * (256 + 64)>();
+                             // out-of-range rows still join the barriers, their loads use a clamped row
+                             iqmv_row<T, NC>((const uint8_t *) vx, tbl, y, dst, ncols, nrows, ldy, ldd,
+                                             it.get_global_id(0), it.get_local_id(0));
+                         });
+}
+
+static int iqmv_type_bit(ggml_type type) {
+    switch (type) {
+        case GGML_TYPE_IQ4_XS:  return 1;
+        case GGML_TYPE_IQ3_S:   return 2;
+        case GGML_TYPE_IQ3_XXS: return 4;
+        case GGML_TYPE_IQ2_XXS: return 8;
+        case GGML_TYPE_IQ2_XS:  return 16;
+        case GGML_TYPE_IQ2_S:   return 32;
+        case GGML_TYPE_IQ4_NL:  return 64;
+        case GGML_TYPE_Q4_K:    return 128;
+        case GGML_TYPE_Q5_K:    return 256;
+        case GGML_TYPE_Q6_K:    return 512;
+        default:                return 0;
+    }
+}
+
+static const uint32_t * iqmv_table(ggml_type type, dpct::queue_ptr stream) {
+    static uint32_t * tables[11] = {};
+    int               slot      = 0;
+    for (int b = iqmv_type_bit(type); b > 1; b >>= 1) {
+        ++slot;
+    }
+    uint32_t *& t = tables[slot];
+    if (!t) {
+        std::vector<uint32_t> h;
+        auto add64 = [&](const uint64_t * g, int n) {
+            h.resize(2 * n);
+            memcpy(h.data(), g, n * sizeof(uint64_t));
+        };
+        switch (type) {
+            case GGML_TYPE_IQ4_XS:
+            case GGML_TYPE_IQ4_NL:
+                // two 16-bit entries per dword: entry b = value of the low nibble | value of the high nibble << 8
+                h.assign(128, 0);
+                for (int b = 0; b < 256; ++b) {
+                    const uint32_t e = (uint32_t) (uint8_t) kvalues_iq4nl[b & 15] | ((uint32_t) (uint8_t) kvalues_iq4nl[b >> 4] << 8);
+                    h[b / 2] |= e << (16 * (b % 2));
+                }
+                break;
+            case GGML_TYPE_IQ3_S:   h.assign(iq3s_grid, iq3s_grid + 512); break;
+            case GGML_TYPE_IQ3_XXS: h.assign(iq3xxs_grid, iq3xxs_grid + 256); break;
+            case GGML_TYPE_IQ2_XXS: add64(iq2xxs_grid, 256); break;
+            case GGML_TYPE_IQ2_XS:  add64(iq2xs_grid, 512); break;
+            case GGML_TYPE_IQ2_S:   add64(iq2s_grid, 1024); break;
+            default: GGML_ABORT("iq mv: type");
+        }
+        t = sycl::malloc_device<uint32_t>(h.size(), *stream);
+        stream->memcpy(t, h.data(), h.size() * sizeof(uint32_t)).wait();
+    }
+    return t;
+}
+
+bool ggml_sycl_iq_mv_ok(const ggml_tensor * src0, int64_t ncols_dst) {
+    // bits 128 / 256 / 512 (Q4_K, Q5_K, Q6_K; Q6_K off by default, its reordered kernel is as fast): plain-layout K-quant weights, which then are never reordered
+    // for the other kernels; vocabulary-sized weights (an LM head, whose row views the MTP draft head
+    // reads reordered) excluded
+    static const int mask = ggml_sycl_get_env("GGML_SYCL_IQ_MV", 511);
+    const bool       kq   = src0->type == GGML_TYPE_Q4_K || src0->type == GGML_TYPE_Q5_K || src0->type == GGML_TYPE_Q6_K;
+    if (!(mask & iqmv_type_bit(src0->type)) || ncols_dst < 1 || ncols_dst > 8 || src0->ne[0] % (4 * QK_K) != 0 ||
+        src0->ne[2] != 1 || src0->ne[3] != 1 || !ggml_is_contiguous(src0) || src0->view_src ||
+        (kq && src0->ne[1] >= 100000)) {
+        return false;
+    }
+    const auto * extra = static_cast<const ggml_tensor_extra_gpu *>(src0->extra);
+    return !(extra && extra->optimized_feature.reorder);
+}
+
+template <ggml_type T>
+static void iqmv_switch(const void * vx, const uint32_t * tbl, const float * y, float * dst, int ncols, int nrows,
+                        int ncols_dst, int ldy, int ldd, dpct::queue_ptr stream) {
+    switch (ncols_dst) {
+        case 1: iqmv_launch<T, 1>(vx, tbl, y, dst, ncols, nrows, ldy, ldd, stream); break;
+        case 2: iqmv_launch<T, 2>(vx, tbl, y, dst, ncols, nrows, ldy, ldd, stream); break;
+        case 3: iqmv_launch<T, 3>(vx, tbl, y, dst, ncols, nrows, ldy, ldd, stream); break;
+        case 4: iqmv_launch<T, 4>(vx, tbl, y, dst, ncols, nrows, ldy, ldd, stream); break;
+        case 5: iqmv_launch<T, 5>(vx, tbl, y, dst, ncols, nrows, ldy, ldd, stream); break;
+        case 6: iqmv_launch<T, 6>(vx, tbl, y, dst, ncols, nrows, ldy, ldd, stream); break;
+        case 7: iqmv_launch<T, 7>(vx, tbl, y, dst, ncols, nrows, ldy, ldd, stream); break;
+        case 8: iqmv_launch<T, 8>(vx, tbl, y, dst, ncols, nrows, ldy, ldd, stream); break;
+        default: GGML_ABORT("iq mv: ncols_dst=%d", ncols_dst);
+    }
+}
+
+void ggml_sycl_iq_mv(ggml_type type, const void * vx, const float * y, float * dst, int ncols, int nrows, int ncols_dst,
+                     int ldy, int ldd, dpct::queue_ptr stream) {
+    const bool       kq  = type == GGML_TYPE_Q4_K || type == GGML_TYPE_Q5_K || type == GGML_TYPE_Q6_K;
+    const uint32_t * tbl = kq ? nullptr : iqmv_table(type, stream);
+    switch (type) {
+        case GGML_TYPE_Q4_K:    iqmv_switch<GGML_TYPE_Q4_K>(vx, tbl, y, dst, ncols, nrows, ncols_dst, ldy, ldd, stream); break;
+        case GGML_TYPE_Q5_K:    iqmv_switch<GGML_TYPE_Q5_K>(vx, tbl, y, dst, ncols, nrows, ncols_dst, ldy, ldd, stream); break;
+        case GGML_TYPE_Q6_K:    iqmv_switch<GGML_TYPE_Q6_K>(vx, tbl, y, dst, ncols, nrows, ncols_dst, ldy, ldd, stream); break;
+        case GGML_TYPE_IQ4_XS:  iqmv_switch<GGML_TYPE_IQ4_XS>(vx, tbl, y, dst, ncols, nrows, ncols_dst, ldy, ldd, stream); break;
+        case GGML_TYPE_IQ4_NL:  iqmv_switch<GGML_TYPE_IQ4_NL>(vx, tbl, y, dst, ncols, nrows, ncols_dst, ldy, ldd, stream); break;
+        case GGML_TYPE_IQ3_S:   iqmv_switch<GGML_TYPE_IQ3_S>(vx, tbl, y, dst, ncols, nrows, ncols_dst, ldy, ldd, stream); break;
+        case GGML_TYPE_IQ3_XXS: iqmv_switch<GGML_TYPE_IQ3_XXS>(vx, tbl, y, dst, ncols, nrows, ncols_dst, ldy, ldd, stream); break;
+        case GGML_TYPE_IQ2_XXS: iqmv_switch<GGML_TYPE_IQ2_XXS>(vx, tbl, y, dst, ncols, nrows, ncols_dst, ldy, ldd, stream); break;
+        case GGML_TYPE_IQ2_XS:  iqmv_switch<GGML_TYPE_IQ2_XS>(vx, tbl, y, dst, ncols, nrows, ncols_dst, ldy, ldd, stream); break;
+        case GGML_TYPE_IQ2_S:   iqmv_switch<GGML_TYPE_IQ2_S>(vx, tbl, y, dst, ncols, nrows, ncols_dst, ldy, ldd, stream); break;
+        default: GGML_ABORT("iq mv: type");
+    }
+}
+
+// dequantize to fp16 (prefill: weights of the types above for the GEMM library) with the same block
+// decoders: each work-item expands 4 consecutive super-blocks, the lookup table sits in SLM.
+// GGML_SYCL_IQ_F16: bit mask as GGML_SYCL_IQ_MV (0 = the generic converters)
+template <ggml_type T>
+static void iq_to_f16(const void * __restrict__ vx, sycl::half * __restrict__ y, int64_t k, dpct::queue_ptr stream) {
+    constexpr int BS = 4, WG = 32;
+    constexpr int BB = iqmv_traits<T>::BB, TBL = iqmv_traits<T>::TBL, NG = iqmv_traits<T>::NG;
+    constexpr int NDW = BS * BB / 4;
+    constexpr int AL  = (BS * BB) % 16 == 0 ? 16 : (BS * BB) % 8 == 0 ? 8 : 4;
+    const int64_t nt  = k / (BS * QK_K);
+    const size_t  ng  = ((size_t) nt + WG - 1) / WG * WG;
+    const uint32_t * tbl = nullptr;
+    if constexpr (TBL > 0) {
+        tbl = iqmv_table(T, stream);
+    }
+    stream->parallel_for(sycl::nd_range<1>(sycl::range<1>(ng), sycl::range<1>(WG)),
+                         [=](sycl::nd_item<1> it) [[intel::sycl_explicit_simd]] {
+        using namespace sycl::ext::intel::esimd;
+        const int     lid = it.get_local_id(0);
+        const int64_t t   = it.get_global_id(0);
+        if constexpr (TBL > 0) {
+            slm_init<TBL * 4>();
+            constexpr int PER = TBL / WG;
+            simd<uint32_t, PER> tv = block_load<uint32_t, PER>(tbl + lid * PER);
+            slm_block_store<uint32_t, PER>((uint32_t) (lid * PER * 4), tv);
+            barrier();
+        }
+        if (t >= nt) {
+            return;
+        }
+        simd<uint32_t, NDW> raw;
+        iqmv_load_dw<NDW, AL>(raw, (const uint32_t *) ((const uint8_t *) vx + (size_t) t * BS * BB));
+        auto rb = raw.template bit_cast_view<uint8_t>();
+#pragma unroll
+        for (int blk = 0; blk < BS; ++blk) {
+            simd<int, 64>   wd;
+            simd<float, NG> sf;
+            simd<float, 8>  mf;
+            iqmv_decode<T>(rb, blk * BB, wd, sf, mf);
+            simd<int8_t, 256> w8 = wd.template bit_cast_view<int8_t>();
+            sycl::half *      yb = y + ((size_t) t * BS + blk) * QK_K;
+#pragma unroll
+            for (int h = 0; h < 4; ++h) {
+                simd<float, 64> v = convert<float>(simd<int8_t, 64>(w8.template select<64, 1>(64 * h)));
+                if constexpr (NG == 16) {
+                    simd<float, 4> s4 = sf.template select<4, 1>(4 * h);
+                    v *= simd<float, 64>(s4.template replicate_vs_w_hs<4, 1, 16, 0>(0));
+                } else {
+                    simd<float, 2> s2 = sf.template select<2, 1>(2 * h);
+                    v *= simd<float, 64>(s2.template replicate_vs_w_hs<2, 1, 32, 0>(0));
+                }
+                if constexpr (T == GGML_TYPE_Q4_K || T == GGML_TYPE_Q5_K) {
+                    simd<float, 2> m2 = mf.template select<2, 1>(2 * h);
+                    v -= simd<float, 64>(m2.template replicate_vs_w_hs<2, 1, 32, 0>(0));
+                }
+                block_store<sycl::half, 64>(yb + 64 * h, convert<sycl::half>(v));
+            }
+        }
+    });
+}
