+// Q3_K (reordered SoA) matvec for 1..8 columns with integer dot products: every work-group quantizes
+// the activation chunk of a step to int8 (one scale per 32 values, as q8_1) into SLM, every thread
+// expands its row's 3-bit weights to int8 and uses dp4a (4 multiply-adds per lane and instruction).
+// The fp32 kernel above runs out of ALU and SLM bandwidth from 3 columns (dequantized fp32 weight
+// times NC fp32 activations per element); here the activations are 4x smaller and the math 4x denser.
+template <int NC, int BS, int WG, int R, bool PIPE>
+ESIMD_INLINE void q3k_dp4a_mv_row(const void * vx, const float * y, float * dst, const int ncols, const int nrows,
+                                  const int ldy, const int ldd, const int row0, const int lid) {
+    using namespace sycl::ext::intel::esimd;
+    using traits = ggml_sycl_esimd::esimd_reorder_q_traits<GGML_TYPE_Q3_K>;
+    const int    bpr = ncols / QK_K;
+    const size_t nb  = (size_t) nrows * bpr;
+    const auto   ps  = traits::make_ptrs(vx, nb);
+
+    constexpr int      PER    = BS * 256 / WG;              // activations per work-item per column
+    constexpr int      NG     = PER / 32;                   // q8 groups per work-item per column
+    constexpr uint32_t QBYTES = NC * BS * 256;              // int8 activations in SLM
+    // R rows per thread: an activation chunk read from SLM serves R rows (SLM bandwidth is the limit
+    // with one row per thread: every row reads the whole quantized activation vector)
+    simd<float, 16>    acc[R][NC];
+#pragma unroll
+    for (int r = 0; r < R; ++r) {
+#pragma unroll
+        for (int c = 0; c < NC; ++c) {
+            acc[r][c] = 0.0f;
+        }
+    }
+    int rr[R];
+#pragma unroll
+    for (int r = 0; r < R; ++r) {
+        rr[r] = row0 + r < nrows ? row0 + r : nrows - 1;
+    }
+
+    // software pipeline (PIPE): the weights of step ib + BS are requested before step ib is computed,
+    // so their memory latency overlaps the quantization and the dot products of the current step
+    simd<uint8_t, 64 * BS> qsb[R];
+    simd<uint8_t, 32 * BS> hmb[R];
+    simd<uint8_t, 12 * BS> scb[R];
+    simd<sycl::half, BS>   db[R];
+    auto load_w = [&](int ibw, simd<uint8_t, 64 * BS> * q, simd<uint8_t, 32 * BS> * h, simd<uint8_t, 12 * BS> * sc,
+                      simd<sycl::half, BS> * d) {
+#pragma unroll
+        for (int r = 0; r < R; ++r) {
+            const size_t g = (size_t) rr[r] * bpr + ibw;
+            q[r]           = block_load<uint8_t, 64 * BS>(ps.qs + g * (QK_K / 4));
+            h[r]           = block_load<uint8_t, 32 * BS>(ps.hmask + g * (QK_K / 8));
+            sc[r]          = block_load<uint8_t, 12 * BS>(ps.scales + g * 12);
+            d[r]           = block_load<sycl::half, BS>(ps.d + g);
+        }
+    };
+    load_w(0, qsb, hmb, scb, db);
+    for (int ib = 0; ib < bpr; ib += BS) {
+        simd<uint8_t, 64 * BS> qsn[R];
+        simd<uint8_t, 32 * BS> hmn[R];
+        simd<uint8_t, 12 * BS> scn[R];
+        simd<sycl::half, BS>   dn[R];
+        if constexpr (PIPE) {
+            load_w(ib + BS < bpr ? ib + BS : ib, qsn, hmn, scn, dn);
+        }
+        barrier();
+#pragma unroll
+        for (int c = 0; c < NC; ++c) {
+            simd<float, PER> yy = block_load<float, PER>(y + (size_t) c * ldy + (size_t) ib * QK_K + lid * PER);
+            simd<int, PER>   qi;
+            simd<float, NG>  dg;
+#pragma unroll
+            for (int g = 0; g < NG; ++g) {
+                simd<float, 32> v    = yy.template select<32, 1>(32 * g);
+                const float     amax = hmax<float>(abs(v));
+                const float     d    = amax / 127.0f;
+                const float     id   = amax > 0.0f ? 127.0f / amax : 0.0f;
+                qi.template select<32, 1>(32 * g) = convert<int>(rnde<float, 32>(simd<float, 32>(v * id)));
+                dg[g]                             = d;
+            }
+            simd<int8_t, PER> q8 = convert<int8_t>(qi);
+            slm_block_store<int, PER / 4>((uint32_t) (c * BS * 256 + lid * PER), q8.template bit_cast_view<int>());
+            simd<float, 2 * NG> dg2;
+#pragma unroll
+            for (int g = 0; g < NG; ++g) {
+                const float dgv = dg[g];
+                dg2[2 * g]      = dgv;
+                dg2[2 * g + 1]  = dgv;
+            }
+            slm_block_store<float, 2 * NG>((uint32_t) (QBYTES + (c * BS * 16 + lid * 2 * NG) * sizeof(float)), dg2);
+        }
+        barrier();
+
+        // 6-bit scale codes of the BS blocks at once: 3 dwords per block -> 4 dwords of 4 codes
+        simd<float, 16 * BS> sfa[R];
+#pragma unroll
+        for (int r = 0; r < R; ++r) {
+            simd<uint32_t, 3 * BS> s32 = scb[r].template bit_cast_view<uint32_t>();
+            simd<uint32_t, BS>     sa  = s32.template select<BS, 3>(0);
+            simd<uint32_t, BS>     sb  = s32.template select<BS, 3>(1);
+            simd<uint32_t, BS>     sc  = s32.template select<BS, 3>(2);
+            const uint32_t         k1  = 0x03030303u, k2 = 0x0f0f0f0fu;
+            simd<uint32_t, 4 * BS> aux;
+            aux.template select<BS, 4>(0) = (sa & k2) | ((sc & k1) << 4);
+            aux.template select<BS, 4>(1) = (sb & k2) | (((sc >> 2) & k1) << 4);
+            aux.template select<BS, 4>(2) = ((sa >> 4) & k2) | (((sc >> 4) & k1) << 4);
+            aux.template select<BS, 4>(3) = ((sb >> 4) & k2) | (((sc >> 6) & k1) << 4);
+            simd<float, 16 * BS> codes = convert<float>(simd<uint8_t, 16 * BS>(aux.template bit_cast_view<uint8_t>()));
+            simd<float, BS>      dbf   = convert<float>(db[r]);
+#pragma unroll
+            for (int blk = 0; blk < BS; ++blk) {
+                const float dv = dbf[blk];
+                sfa[r].template select<16, 1>(16 * blk) = (codes.template select<16, 1>(16 * blk) - 32.0f) * dv;
+            }
+        }
+#pragma unroll
+        for (int blk = 0; blk < BS; ++blk) {
+            simd<int, 64>   wd[R];
+            simd<float, 16> sf[R];
+#pragma unroll
+            for (int r = 0; r < R; ++r) {
+                simd<uint8_t, 64> qs = qsb[r].template select<64, 1>(64 * blk);
+                simd<uint8_t, 32> hm = hmb[r].template select<32, 1>(32 * blk);
+                sf[r] = sfa[r].template select<16, 1>(16 * blk);
+                simd<uint8_t, 256> w;
+#pragma unroll
+                for (int s = 0; s < 8; ++s) {
+                    const int          byte_base = 32 * (s / 4);
+                    const uint8_t      shift     = (uint8_t) (2 * (s % 4));
+                    simd<uint16_t, 32> q3 = convert<uint16_t>((qs.template select<32, 1>(byte_base) >> shift) & simd<uint8_t, 32>(3));
+                    q3 |= convert<uint16_t>(((hm >> simd<uint8_t, 32>((uint8_t) s)) & simd<uint8_t, 32>(1)) << simd<uint8_t, 32>(2));
+                    // q - 4 in two's complement bytes
+                    w.template select<32, 1>(32 * s) = convert<uint8_t>((q3 + simd<uint16_t, 32>(252)) & simd<uint16_t, 32>(0xFF));
+                }
+                wd[r] = w.template bit_cast_view<int>();
+            }
+#pragma unroll
+            for (int c = 0; c < NC; ++c) {
+                simd<int, 64>   yd = slm_block_load<int, 64>((uint32_t) (c * BS * 256 + blk * 256));
+                simd<float, 16> ye = slm_block_load<float, 16>((uint32_t) (QBYTES + (c * BS * 16 + blk * 16) * sizeof(float)));
+#pragma unroll
+                for (int r = 0; r < R; ++r) {
+                    simd<int, 64> p  = dp4a<int, int, int, int, 64>(simd<int, 64>(0), wd[r], yd);
+                    simd<int, 16> gs = p.template select<16, 4>(0) + p.template select<16, 4>(1) +
+                                       p.template select<16, 4>(2) + p.template select<16, 4>(3);
+                    acc[r][c] += convert<float>(gs) * sf[r] * ye;
+                }
+            }
+        }
+        if constexpr (PIPE) {
+#pragma unroll
+            for (int r = 0; r < R; ++r) {
+                qsb[r] = qsn[r];
+                hmb[r] = hmn[r];
+                scb[r] = scn[r];
+                db[r]  = dn[r];
+            }
+        } else if (ib + BS < bpr) {
+            load_w(ib + BS, qsb, hmb, scb, db);
+        }
+    }
+#pragma unroll
+    for (int r = 0; r < R; ++r) {
+        if (row0 + r < nrows) {
+#pragma unroll
+            for (int c = 0; c < NC; ++c) {
+                dst[(size_t) c * ldd + row0 + r] = reduce<float>(acc[r][c], std::plus<>());
+            }
+        }
+    }
+}
+
+template <int NC, int WG, int R, bool PIPE>
+static void q3k_dp4a_mv_launch_wg(const void * vx, const float * y, float * dst, const int ncols, const int nrows,
+                                  const int ldy, const int ldd, dpct::queue_ptr stream) {
+    const size_t nt  = ((size_t) nrows + R - 1) / R;
+    const size_t ng  = (nt + WG - 1) / WG * WG;
+    const bool   bs4 = (ncols / QK_K) % 4 == 0;
+    stream->parallel_for(sycl::nd_range<1>(sycl::range<1>(ng), sycl::range<1>(WG)),
+                         [=](sycl::nd_item<1> it) [[intel::sycl_explicit_simd]] {
+                             const int row0 = it.get_global_id(0) * R;
+                             const int lid  = it.get_local_id(0);
+                             sycl::ext::intel::esimd::slm_init<NC * 4 * (256 + 16 * sizeof(float))>();
+                             // out-of-range threads still join the barriers; loads use clamped rows
+                             if (bs4) {
+                                 q3k_dp4a_mv_row<NC, 4, WG, R, PIPE>(vx, y, dst, ncols, nrows, ldy, ldd, row0, lid);
+                             } else if constexpr (WG == 16) {
+                                 q3k_dp4a_mv_row<NC, 2, WG, R, PIPE>(vx, y, dst, ncols, nrows, ldy, ldd, row0, lid);
+                             }
+                         });
+}
+
+template <int NC>
+static void q3k_dp4a_mv_launch(const void * vx, const float * y, float * dst, const int ncols, const int nrows,
+                               const int ldy, const int ldd, dpct::queue_ptr stream) {
+    if ((ncols / QK_K) % 4 == 0) {
+        q3k_dp4a_mv_launch_wg<NC, 32, 1, false>(vx, y, dst, ncols, nrows, ldy, ldd, stream);
+    } else {
+        q3k_dp4a_mv_launch_wg<NC, 16, 1, false>(vx, y, dst, ncols, nrows, ldy, ldd, stream);
+    }
+}
