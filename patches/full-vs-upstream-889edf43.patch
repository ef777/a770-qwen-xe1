+// small f32 weight matrices (e.g. the DeltaNet alpha/beta projections, 48 x 5120) with 1..8 columns:
+// one work-group of 256 per output row splits K, a single launch instead of the GEMM library path.
+template <int NC>
+static void mul_mat_f32_small_nc(const float * x, const float * y0, float * dst0, const int k, const int nrows,
+                                 const int ldy, const int ldd, const int ncb, dpct::queue_ptr stream) {
+    constexpr int WG = 256;
+    stream->submit([&](sycl::handler & cgh) {
+    sycl::local_accessor<float, 1> part(sycl::range<1>(NC * (WG / 16)), cgh);
+    cgh.parallel_for(sycl::nd_range<2>(sycl::range<2>(ncb, (size_t) nrows * WG), sycl::range<2>(1, WG)),
+                         [=](sycl::nd_item<2> it) [[sycl::reqd_sub_group_size(16)]] {
+                             const int     row = it.get_group(1);
+                             const int     tid = it.get_local_id(1);
+                             const int     cb  = it.get_group(0);  // block of NC columns
+                             const float * y   = y0 + (size_t) cb * NC * ldy;
+                             float *       dst = dst0 + (size_t) cb * NC * ldd;
+                             const float * xr  = x + (size_t) row * k;
