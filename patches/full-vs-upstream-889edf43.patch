+// Q3_K (reordered SoA) matvec for 1..4 columns, one thread per weight row: two consecutive
+// super-blocks per step come in with wide block loads (128 B qs, 64 B hmask, 2x12 B scales),
+// each block is dequantized once into 256 floats and applied to every activation column.
+// No work-group reduction; 128 GRF so many threads stay resident. GGML_SYCL_Q3K_FAST=0 disables.
+template <int NC, int BS, bool SY>
+ESIMD_INLINE void q3k_fast_mv_row(const void * vx, const float * y, float * dst, const int ncols, const int nrows,
+                                  const int ldy, const int ldd, const int row, const int lid) {
+    using namespace sycl::ext::intel::esimd;
+    using traits = ggml_sycl_esimd::esimd_reorder_q_traits<GGML_TYPE_Q3_K>;
+    const int    bpr = ncols / QK_K;
+    const size_t nb  = (size_t) nrows * bpr;
+    const auto   ps  = traits::make_ptrs(vx, nb);
+
+    simd<float, 32> acc[NC];
+#pragma unroll
+    for (int c = 0; c < NC; ++c) {
+        acc[c] = 0.0f;
+    }
+    simd<float, 256> w;
+
+    // BS consecutive super-blocks of the row per step: one 64*BS byte qs load and one 32*BS byte
+    // hmask load (larger messages reach more of the read bandwidth than 64 B ones)
+    // SY: the 16 rows of the work-group share the activation blocks through SLM; every work-item
+    // loads 1/16 of the NC*BS*256 floats once per step instead of each row reading them all
+    for (int ib = 0; ib < bpr; ib += BS) {
+        if constexpr (SY) {
+            barrier();
+            constexpr int PER = BS * 256 / 16;  // floats per work-item per column
+#pragma unroll
+            for (int c = 0; c < NC; ++c) {
+                simd<float, PER> yy = block_load<float, PER>(y + (size_t) c * ldy + (size_t) ib * QK_K + lid * PER);
+                slm_block_store<float, PER>((uint32_t) ((c * BS * 256 + lid * PER) * sizeof(float)), yy);
+            }
+            barrier();
+        }
+        const size_t            g   = (size_t) (row < nrows ? row : nrows - 1) * bpr + ib;
+        simd<uint8_t, 64 * BS>  qsb = block_load<uint8_t, 64 * BS>(ps.qs + g * (QK_K / 4));
+        simd<uint8_t, 32 * BS>  hmb = block_load<uint8_t, 32 * BS>(ps.hmask + g * (QK_K / 8));
+        simd<uint8_t, 12 * BS>  scb = block_load<uint8_t, 12 * BS>(ps.scales + g * 12);
+        simd<sycl::half, BS>    db  = block_load<sycl::half, BS>(ps.d + g);
+        simd<float, BS>         dbf = convert<float>(db);
+#pragma unroll
+        for (int blk = 0; blk < BS; ++blk) {
+            simd<uint8_t, 64> qs = qsb.template select<64, 1>(64 * blk);
+            simd<uint8_t, 32> hm = hmb.template select<32, 1>(32 * blk);
+            simd<uint8_t, 12> sc = scb.template select<12, 1>(12 * blk);
+            simd<float, 16>   sf = traits::unpack_scales(sc, dbf[blk]);
+#pragma unroll
+            for (int s = 0; s < 8; ++s) {
+                const int          byte_base = 32 * (s / 4);
+                const uint8_t      shift     = (uint8_t) (2 * (s % 4));
+                simd<uint16_t, 32> q3 = convert<uint16_t>((qs.template select<32, 1>(byte_base) >> shift) & simd<uint8_t, 32>(3));
+                q3 |= convert<uint16_t>(((hm >> simd<uint8_t, 32>((uint8_t) s)) & simd<uint8_t, 32>(1)) << simd<uint8_t, 32>(2));
+                w.template select<32, 1>(32 * s) =
+                    (convert<float>(q3) - 4.0f) * ggml_sycl_esimd::splat_lo_hi(sf[2 * s], sf[2 * s + 1]);
+            }
+#pragma unroll
+            for (int c = 0; c < NC; ++c) {
+                simd<float, 256> yv;
+                if constexpr (SY) {
+                    yv = slm_block_load<float, 256>((uint32_t) ((c * BS * 256 + blk * 256) * sizeof(float)));
+                } else {
+                    yv = block_load<float, 256>(y + (size_t) c * ldy + (size_t) (ib + blk) * QK_K);
+                }
+#pragma unroll
+                for (int s = 0; s < 8; ++s) {
+                    acc[c] += yv.template select<32, 1>(32 * s) * w.template select<32, 1>(32 * s);
+                }
+            }
+        }
+    }
+    if (row < nrows) {
+#pragma unroll
+        for (int c = 0; c < NC; ++c) {
+            dst[(size_t) c * ldd + row] = reduce<float>(acc[c], std::plus<>());
+        }
+    }
+}
+
+template <int NC>
+static void q3k_fast_mv_launch(const void * vx, const float * y, float * dst, const int ncols, const int nrows,
+                               const int ldy, const int ldd, dpct::queue_ptr stream) {
+    constexpr int WG = 16;
+    const size_t  ng = ((size_t) nrows + WG - 1) / WG * WG;
+    static const int bs_env = ggml_sycl_get_env("GGML_SYCL_Q3K_BS", 4);
+    const bool       bs4    = bs_env >= 4 && (ncols / QK_K) % 4 == 0;
+    static const int sy_env = ggml_sycl_get_env("GGML_SYCL_Q3K_SLMY", 1);
+    const bool       sy     = sy_env && NC >= 2;
+    stream->parallel_for(sycl::nd_range<1>(sycl::range<1>(ng), sycl::range<1>(WG)),
+                         [=](sycl::nd_item<1> it) [[intel::sycl_explicit_simd]] {
+                             const int row = it.get_global_id(0);
+                             const int lid  = it.get_local_id(0);
+                             sycl::ext::intel::esimd::slm_init<NC * 4 * 256 * sizeof(float)>();
+                             // out-of-range rows still run (they join the SLM barriers), loads use a clamped row
+                             if (sy) {
+                                 if (bs4) {
+                                     q3k_fast_mv_row<NC, 4, true>(vx, y, dst, ncols, nrows, ldy, ldd, row, lid);
+                                 } else {
+                                     q3k_fast_mv_row<NC, 2, true>(vx, y, dst, ncols, nrows, ldy, ldd, row, lid);
+                                 }
+                             } else if (row < nrows) {
+                                 if (bs4) {
+                                     q3k_fast_mv_row<NC, 4, false>(vx, y, dst, ncols, nrows, ldy, ldd, row, lid);
+                                 } else {
+                                     q3k_fast_mv_row<NC, 2, false>(vx, y, dst, ncols, nrows, ldy, ldd, row, lid);
+                                 }
+                             }
+                         });
+}
