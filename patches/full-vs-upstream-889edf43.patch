+                             for (int c = 0; c < NC; ++c) {
+                                 acc[c] = 0.0f;
+                             }
+                             for (int i = tid * 4; i < k; i += WG * 4) {
+                                 const sycl::float4 w = *(const sycl::float4 *) (xr + i);
