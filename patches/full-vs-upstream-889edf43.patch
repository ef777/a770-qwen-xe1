+                                                    dpct::queue_ptr stream) {
+    constexpr int WG = 16;
+    constexpr int BS = 4;
+    const int64_t nt = nb_total / BS;
+    const int64_t ng = (nt + WG - 1) / WG * WG;
+    stream->parallel_for(sycl::nd_range<1>(sycl::range<1>(ng), sycl::range<1>(WG)),
+        [=](sycl::nd_item<1> it) SYCL_ESIMD_KERNEL {
+            using namespace sycl::ext::intel::esimd;
+            using T = ggml_sycl_esimd::esimd_reorder_q_traits<GGML_TYPE_Q3_K>;
+            const int64_t t = it.get_global_id(0);
+            if (t >= nt) {
+                return;
+            }
+            const int64_t           g   = t * BS;
+            const auto              p   = T::make_ptrs(vx, (size_t) nb_total);
+            simd<uint8_t, 64 * BS>  qsb = block_load<uint8_t, 64 * BS>(p.qs + g * (QK_K / 4));
+            simd<uint8_t, 32 * BS>  hmb = block_load<uint8_t, 32 * BS>(p.hmask + g * (QK_K / 8));
+            simd<uint8_t, 12 * BS>  scb = block_load<uint8_t, 12 * BS>(p.scales + g * 12);
+            simd<sycl::half, BS>    db  = block_load<sycl::half, BS>(p.d + g);
+            simd<uint32_t, 3 * BS>  s32 = scb.template bit_cast_view<uint32_t>();
+            simd<uint32_t, BS>      sa  = s32.template select<BS, 3>(0);
+            simd<uint32_t, BS>      sb  = s32.template select<BS, 3>(1);
+            simd<uint32_t, BS>      sc  = s32.template select<BS, 3>(2);
+            const uint32_t          k1  = 0x03030303u, k2 = 0x0f0f0f0fu;
+            simd<uint32_t, 4 * BS>  aux;
+            aux.template select<BS, 4>(0) = (sa & k2) | ((sc & k1) << 4);
+            aux.template select<BS, 4>(1) = (sb & k2) | (((sc >> 2) & k1) << 4);
+            aux.template select<BS, 4>(2) = ((sa >> 4) & k2) | (((sc >> 4) & k1) << 4);
+            aux.template select<BS, 4>(3) = ((sb >> 4) & k2) | (((sc >> 6) & k1) << 4);
