+// dim-0 concat of a contiguous src0 with a transposed src1 (ne0 strided by nb10, ne1 dense), as in
+// the DeltaNet conv input concat(conv_states, transpose(qkv)): a per-element loop walks src1 with
+// a large stride. Here 32x32 tiles are read along src1's dense dimension, transposed in local
+// memory and written along dst's dense dimension; the src0 columns are copied directly.
+template <typename T>
+static void concat_dim0_transposed_src1(queue_ptr stream, const ggml_tensor * src0, const ggml_tensor * src1,
+                                        ggml_tensor * dst) {
+    constexpr int TS = 32;
+    const int64_t ne00 = src0->ne[0];
+    const int64_t ne10 = src1->ne[0], ne11 = src1->ne[1], ne12 = src1->ne[2], ne13 = src1->ne[3];
+    const char *  s0   = (const char *) src0->data;
+    const char *  s1   = (const char *) src1->data;
+    char *        d    = (char *) dst->data;
+    const size_t  nb01 = src0->nb[1], nb02 = src0->nb[2], nb03 = src0->nb[3];
+    const size_t  nb10 = src1->nb[0], nb12 = src1->nb[2], nb13 = src1->nb[3];
+    const size_t  nb1 = dst->nb[1], nb2 = dst->nb[2], nb3 = dst->nb[3];
+
+    // src0 part: ne00 values per (i1, i2, i3) row
+    stream->parallel_for(sycl::range<3>(ne13 * ne12, ne11, ne00), [=](sycl::item<3> it) {
+        const int64_t i23 = it.get_id(0), i1 = it.get_id(1), i0 = it.get_id(2);
+        const int64_t i2 = i23 % ne12, i3 = i23 / ne12;
+        *(T *) (d + i3 * nb3 + i2 * nb2 + i1 * nb1 + i0 * sizeof(T)) =
+            *(const T *) (s0 + i3 * nb03 + i2 * nb02 + i1 * nb01 + i0 * sizeof(T));
+    });
+
+    // src1 part, tiled transpose
+    const size_t g0 = (size_t) ((ne10 + TS - 1) / TS) * TS;  // along src1 ne0 (dst ne0 offset ne00)
+    const size_t g1 = (size_t) ((ne11 + TS - 1) / TS) * TS;  // along ne1 (dense in src1)
+    stream->submit([&](sycl::handler & cgh) {
+        sycl::local_accessor<T, 2> tile(sycl::range<2>(TS, TS + 1), cgh);
+        cgh.parallel_for(sycl::nd_range<3>(sycl::range<3>(ne13 * ne12, g0, g1 / 4), sycl::range<3>(1, TS, TS / 4)),
+                         [=](sycl::nd_item<3> it) {
+            const int64_t i23 = it.get_global_id(0);
+            const int64_t i2 = i23 % ne12, i3 = i23 / ne12;
+            const int     ly = it.get_local_id(1);   // 0..31
+            const int     lx = it.get_local_id(2);   // 0..7
+            const int64_t b0 = it.get_group(1) * TS;  // tile origin along ne0
+            const int64_t b1 = it.get_group(2) * TS;  // tile origin along ne1
+            // read: ly walks ne0 (token), 4 consecutive ne1 per work-item (dense in src1)
+#pragma unroll
+            for (int k = 0; k < 4; ++k) {
+                const int64_t i0 = b0 + ly;
+                const int64_t i1 = b1 + lx + k * (TS / 4);
+                T v = T(0);
+                if (i0 < ne10 && i1 < ne11) {
+                    v = *(const T *) (s1 + i3 * nb13 + i2 * nb12 + i0 * nb10 + i1 * sizeof(T));
+                }
+                tile[ly][lx + k * (TS / 4)] = v;
+            }
+            sycl::group_barrier(it.get_group());
+            // write: ly walks ne1, 4 consecutive ne0 (dense in dst)
+#pragma unroll
+            for (int k = 0; k < 4; ++k) {
+                const int64_t i1 = b1 + ly;
+                const int64_t i0 = b0 + lx + k * (TS / 4);
+                if (i0 < ne10 && i1 < ne11) {
+                    *(T *) (d + i3 * nb3 + i2 * nb2 + i1 * nb1 + (ne00 + i0) * sizeof(T)) = tile[lx + k * (TS / 4)][ly];
+                }
+            }
+        });
+    });
+}
