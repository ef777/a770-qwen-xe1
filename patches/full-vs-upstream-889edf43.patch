+                             for (int c = 0; c < NC; ++c) {
+                                 const float v = sycl::reduce_over_group(sg, acc[c], sycl::plus<float>());
+                                 if (sg.get_local_linear_id() == 0) {
+                                     part[c * (WG / 16) + sgid] = v;
+                                 }
+                             }
+                             sycl::group_barrier(it.get_group());
+                             if (tid < NC) {
+                                 float sum = 0.0f;
