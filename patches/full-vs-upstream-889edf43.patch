+}
+
+static int g_dmmv_layout_rows = 0;  // > 0 while running on a row view of a larger reordered tensor
+
+// multi-column variant (2..8 activation columns) of the reordered ESIMD dequantize-matvec:
+// the weight block of a row pair is read from VRAM once per column loop (the repeats hit L1),
+// so the step cost of a small batch (speculative decoding verify) stays near one column.
+template <ggml_type T, int NC, bool DEQ_ONCE>
+ESIMD_INLINE void dequantize_mul_mat_vec_reorder_esimd_ncols(
+        const void * vx, const float * y, float * dst,
+        const int ncols, const int nrows, const int ldy, const int ldd, const int nrows_layout,
+        sycl::local_accessor<float, 1> lmem,
+        const sycl::nd_item<1> & it) {
+    using namespace sycl::ext::intel::esimd;
+    using traits = ggml_sycl_esimd::esimd_reorder_q_traits<T>;
+
+    const int    num_blocks_per_row = ncols / QK_K;
+    // nrows_layout: rows of the reordered tensor (SoA section sizes), nrows: rows computed (a view of
+    // the first rows of a reordered tensor, e.g. a vocabulary-trimmed LM head)
+    const size_t nb = (size_t) nrows_layout * num_blocks_per_row;
+    const auto   ps = traits::make_ptrs(vx, nb);
+
+    const int  tid      = it.get_local_id(0);
+    const int  row0     = it.get_group(0) * 2;
+    const bool has_row1 = row0 + 1 < nrows;
+
+    simd<float, 32> acc0[NC];
+    simd<float, 32> acc1[NC];
+#pragma unroll
+    for (int c = 0; c < NC; ++c) {
+        acc0[c] = 0.0f;
+        acc1[c] = 0.0f;
+    }
+
+    for (int ib = tid; ib < num_blocks_per_row; ib += GGML_SYCL_DMMV_ESIMD_WG_SIZE) {
+        const size_t bi0 = (size_t) (row0 + 0) * num_blocks_per_row + ib;
+        const size_t bi1 = (size_t) (row0 + 1) * num_blocks_per_row + ib;
+        if constexpr (DEQ_ONCE) {
+            // dequantize the row pair once, then one FMA pass per activation column
+            simd<float, 256> wa, wb;
+            traits::deq_pair(ps, bi0, ps, bi1, has_row1, wa, wb);
+#pragma unroll
+            for (int c = 0; c < NC; ++c) {
+#pragma unroll
+                for (int hh = 0; hh < 2; ++hh) {
+                    simd<float, 128> yv = block_load<float, 128>(y + (size_t) c * ldy + (size_t) ib * QK_K + hh * 128);
+#pragma unroll
+                    for (int s4 = 0; s4 < 4; ++s4) {
+                        acc0[c] += yv.template select<32, 1>(32 * s4) * wa.template select<32, 1>(hh * 128 + 32 * s4);
+                        acc1[c] += yv.template select<32, 1>(32 * s4) * wb.template select<32, 1>(hh * 128 + 32 * s4);
+                    }
+                }
+            }
+        } else {
+#pragma unroll
+        for (int c = 0; c < NC; ++c) {
+            simd<float, 256> y_vec = block_load<float, 256>(y + (size_t) c * ldy + (size_t) ib * QK_K);
+            traits::mac_pair(ps, bi0, ps, bi1, has_row1, y_vec, acc0[c], acc1[c]);
+        }
+        }
+    }
+
+#pragma unroll
+    for (int c = 0; c < NC; ++c) {
+        lmem[(tid * NC + c) * 2 + 0] = reduce<float>(acc0[c], std::plus<>{});
+        lmem[(tid * NC + c) * 2 + 1] = reduce<float>(acc1[c], std::plus<>{});
+    }
+    it.barrier(sycl::access::fence_space::local_space);
+
+    if (tid == 0) {
+#pragma unroll
+        for (int c = 0; c < NC; ++c) {
+            float sum0 = 0.0f;
+            float sum1 = 0.0f;
+            for (int p = 0; p < GGML_SYCL_DMMV_ESIMD_WG_SIZE; ++p) {
+                sum0 += lmem[(p * NC + c) * 2 + 0];
+                sum1 += lmem[(p * NC + c) * 2 + 1];
+            }
+            dst[(size_t) c * ldd + row0 + 0] = sum0;
+            if (has_row1) {
+                dst[(size_t) c * ldd + row0 + 1] = sum1;
+            }
+        }
+    }
+}
+
+template <ggml_type T, int NC>
+static void dmmv_reorder_esimd_ncols_launch(const void * vx, const float * y, float * dst, const int ncols,
+                                            const int nrows, const int ldy, const int ldd, dpct::queue_ptr stream) {
+    GGML_ASSERT(ncols % QK_K == 0);
+    // GGML_SYCL_DMMV_NCOLS=1: old per-column mac_pair kernel, 2 (default): dequantize once
+    static const int ncols_mode = ggml_sycl_get_env("GGML_SYCL_DMMV_NCOLS", 2);
+    const bool       deq_once   = ncols_mode >= 2;
+    const int workgroups = (nrows + 1) / 2;
+    const int nrl        = g_dmmv_layout_rows > 0 ? g_dmmv_layout_rows : nrows;
+    stream->submit([&](sycl::handler & h) {
+        sycl::local_accessor<float, 1> lmem(sycl::range<1>(GGML_SYCL_DMMV_ESIMD_WG_SIZE * NC * 2), h);
+        if (deq_once) {
+            h.parallel_for(
+                sycl::nd_range<1>(sycl::range<1>((size_t) workgroups * GGML_SYCL_DMMV_ESIMD_WG_SIZE),
+                                  sycl::range<1>(GGML_SYCL_DMMV_ESIMD_WG_SIZE)),
+                sycl::ext::oneapi::experimental::properties{ sycl::ext::intel::experimental::grf_size<256> },
+                [=](sycl::nd_item<1> it) [[intel::sycl_explicit_simd]] {
+                    dequantize_mul_mat_vec_reorder_esimd_ncols<T, NC, true>(vx, y, dst, ncols, nrows, ldy, ldd, nrl, lmem, it);
+                });
+        } else {
+            h.parallel_for(
+                sycl::nd_range<1>(sycl::range<1>((size_t) workgroups * GGML_SYCL_DMMV_ESIMD_WG_SIZE),
+                                  sycl::range<1>(GGML_SYCL_DMMV_ESIMD_WG_SIZE)),
+                [=](sycl::nd_item<1> it) [[intel::sycl_explicit_simd]] {
+                    dequantize_mul_mat_vec_reorder_esimd_ncols<T, NC, false>(vx, y, dst, ncols, nrows, ldy, ldd, nrl, lmem, it);
+                });
+        }
+    });
+}
