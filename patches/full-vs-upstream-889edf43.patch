+void ggml_sycl_op_dmmv_esimd_ncols(ggml_backend_sycl_context & ctx, const ggml_tensor * src0,
+                                   const ggml_tensor * src1, ggml_tensor * dst, const char * src0_dd_i,
+                                   const float * src1_ddf_i, const char * src1_ddq_i, float * dst_dd_i,
+                                   const int64_t row_low, const int64_t row_high, const int64_t src1_ncols,
+                                   const int64_t src1_padded_row_size, const dpct::queue_ptr & stream) {
+    GGML_UNUSED(ctx);
+    GGML_UNUSED(src1_ddq_i);
+    GGML_UNUSED(src1_padded_row_size);
+    const int ne00     = src0->ne[0];
+    const int row_diff = row_high - row_low;
+    const int ldy      = src1->ne[0];
+    const int ldd      = dst->ne[0];
+    // more than 4 columns spill registers: run them as two balanced launches (5 = 3 + 2, 8 = 4 + 4)
+    // ESIMD fast Q3_K kernel for 1..3 columns; the chunk loop below also uses it per chunk (5 = 3 + 2)
+    if (ggml_sycl_q3k_fast_ok(src0, src1_ncols)) {
+        ggml_sycl_q3k_fast_mv(src0_dd_i, src1_ddf_i, dst_dd_i, ne00, row_diff, (int) src1_ncols, ldy, ldd, stream);
+        return;
+    }
+    const int ncols_all = (int) src1_ncols;
+    for (int c0 = 0; c0 < ncols_all;) {
+    const int nc = ncols_all - c0 <= 4 ? ncols_all - c0 : (ncols_all - c0 + 1) / 2;
+    const float * y_c = src1_ddf_i + (size_t) c0 * ldy;
+    float *       d_c = dst_dd_i + (size_t) c0 * ldd;
+    c0 += nc;
+    switch (src0->type) {
+        case GGML_TYPE_Q2_K: dmmv_reorder_esimd_ncols_switch<GGML_TYPE_Q2_K>(src0_dd_i, y_c, d_c, ne00, row_diff, nc, ldy, ldd, stream); break;
+        case GGML_TYPE_Q3_K: dmmv_reorder_esimd_ncols_switch<GGML_TYPE_Q3_K>(src0_dd_i, y_c, d_c, ne00, row_diff, nc, ldy, ldd, stream); break;
+        case GGML_TYPE_Q4_K: dmmv_reorder_esimd_ncols_switch<GGML_TYPE_Q4_K>(src0_dd_i, y_c, d_c, ne00, row_diff, nc, ldy, ldd, stream); break;
+        case GGML_TYPE_Q5_K: dmmv_reorder_esimd_ncols_switch<GGML_TYPE_Q5_K>(src0_dd_i, y_c, d_c, ne00, row_diff, nc, ldy, ldd, stream); break;
+        case GGML_TYPE_Q6_K: dmmv_reorder_esimd_ncols_switch<GGML_TYPE_Q6_K>(src0_dd_i, y_c, d_c, ne00, row_diff, nc, ldy, ldd, stream); break;
+        default: GGML_ABORT("ESIMD DMMV ncols: unsupported type");
+    }
+    }
+}
