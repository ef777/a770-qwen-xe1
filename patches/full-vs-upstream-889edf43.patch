+static void dequantize_row_q3_K_sycl_reorder_esimd_range(const void * vx, dst_t * y, const int64_t nb_total,
+                                                         const int64_t b0, const int64_t nblk,
+                                                         dpct::queue_ptr stream) {
+    constexpr int WG = 16;
+    const int64_t nb = nblk;
+    const int64_t ng = (nb + WG - 1) / WG * WG;
+    stream->parallel_for(sycl::nd_range<1>(sycl::range<1>(ng), sycl::range<1>(WG)),
+        [=](sycl::nd_item<1> it) SYCL_ESIMD_KERNEL {
+            using namespace sycl::ext::intel::esimd;
+            using T = ggml_sycl_esimd::esimd_reorder_q_traits<GGML_TYPE_Q3_K>;
+            const int64_t i = it.get_global_id(0);
+            if (i >= nb) {
+                return;
+            }
+            const int64_t     g  = b0 + i;
+            const auto        p  = T::make_ptrs(vx, (size_t) nb_total);
+            simd<uint8_t, 64> qs = block_load<uint8_t, 64>(p.qs + g * (QK_K / 4));
+            simd<uint8_t, 32> hm = block_load<uint8_t, 32>(p.hmask + g * (QK_K / 8));
+            simd<uint8_t, 12> sc = block_load<uint8_t, 12>(p.scales + g * 12);
+            simd<float, 16>   sf = T::unpack_scales(sc, (float) p.d[g]);
