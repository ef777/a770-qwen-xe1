+// Large copies between the device and pageable host memory (e.g. the server's context checkpoints
+// of a recurrent model, ~176 MB each) run through two pinned staging buffers: the device copy of
+// one chunk overlaps the host memcpy of the other. GGML_SYCL_BOUNCE_MB: chunk size, 0 disables.
+static bool ggml_sycl_bounce_copy(sycl::queue & q, void * dst, const void * src, size_t size, bool to_host) {
+    static const int  chunk_mb = ggml_sycl_get_env("GGML_SYCL_BOUNCE_MB", 16);
+    static std::mutex mtx;
+    static char *     pin[2]   = { nullptr, nullptr };
+    static sycl::context pin_ctx;
+    if (chunk_mb <= 0 || size < (size_t) 4 * 1024 * 1024) {
+        return false;
+    }
+    const size_t                chunk = (size_t) chunk_mb * 1024 * 1024;
+    std::lock_guard<std::mutex> lock(mtx);
+    if (!pin[0] || pin_ctx != q.get_context()) {
+        if (pin[0]) {
+            sycl::free(pin[0], pin_ctx);
+            sycl::free(pin[1], pin_ctx);
+        }
+        pin_ctx = q.get_context();
+        pin[0]  = (char *) sycl::malloc_host(chunk, q);
+        pin[1]  = (char *) sycl::malloc_host(chunk, q);
+        if (!pin[0] || !pin[1]) {
+            return false;
+        }
+    }
+    const size_t n = (size + chunk - 1) / chunk;
+    if (to_host) {
+        // device -> pin[i % 2] for chunk i + 1 while the host copies chunk i out
+        sycl::event ev[2];
+        auto        issue = [&](size_t i) {
+            const size_t off = i * chunk, len = std::min(chunk, size - off);
+            ev[i % 2]        = q.memcpy(pin[i % 2], (const char *) src + off, len);
+        };
+        issue(0);
+        for (size_t i = 0; i < n; ++i) {
+            ev[i % 2].wait();
+            if (i + 1 < n) {
+                issue(i + 1);
+            }
+            const size_t off = i * chunk, len = std::min(chunk, size - off);
+            memcpy((char *) dst + off, pin[i % 2], len);
+        }
+    } else {
+        // host fills pin[i % 2] while the device copy of chunk i - 1 runs
+        sycl::event ev[2];
+        for (size_t i = 0; i < n; ++i) {
+            const size_t off = i * chunk, len = std::min(chunk, size - off);
+            if (i >= 2) {
+                ev[i % 2].wait();
+            }
+            memcpy(pin[i % 2], (const char *) src + off, len);
+            ev[i % 2] = q.memcpy((char *) dst + off, pin[i % 2], len);
+        }
+        ev[0].wait();
+        ev[1].wait();
+    }
+    return true;
+}
